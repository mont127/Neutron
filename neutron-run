#!/bin/bash
# launch shim steam calls per game: neutron-run %command%
# runs a windows exe under mnc's unified wine, talking to the native mac steam
# client through the lsteamclient bridge. no windows steam.
set -euo pipefail

NEUTRON_HOME="${NEUTRON_HOME:-$HOME/Library/Application Support/Neutron}"
# paths only. pinning MNC_GAME_BACKEND here used to override the backend the
# caller picked, on every launch.
# config is sourced, so it clobbers anything the caller exported. Save the
# caller's values first and put them back afterwards -- otherwise pointing a
# test run at a throwaway prefix with NEUTRON_PREFIX=... silently runs against
# the real one instead.
_caller_backend="${MNC_GAME_BACKEND:-}"
_caller_prefix="${NEUTRON_PREFIX:-}"
_caller_wine="${NEUTRON_WINE:-}"
[ -f "$NEUTRON_HOME/config" ] && . "$NEUTRON_HOME/config"
[ -n "$_caller_backend" ] && MNC_GAME_BACKEND="$_caller_backend"
[ -n "$_caller_prefix" ] && NEUTRON_PREFIX="$_caller_prefix"
[ -n "$_caller_wine" ] && NEUTRON_WINE="$_caller_wine"
# running neutron-run directly (not via steam) should still honour the settings
if [ -z "${MNC_GAME_BACKEND:-}" ] && [ -f "$NEUTRON_HOME/defaults" ]; then
    . "$NEUTRON_HOME/defaults"
fi

# steam reports nothing when a launch fails, so leave a trail: one line per
# launch and one for every reason a session ends.
NEUTRON_LOG="$HOME/Library/Logs/neutron-launch.log"
mkdir -p "$HOME/Library/Logs" 2>/dev/null || true
if [ -f "$NEUTRON_LOG" ]; then
    _sz="$(stat -f %z "$NEUTRON_LOG" 2>/dev/null || echo 0)"
    if [ "${_sz:-0}" -gt 262144 ]; then
        tail -c 65536 "$NEUTRON_LOG" > "$NEUTRON_LOG.trim" 2>/dev/null \
            && mv -f "$NEUTRON_LOG.trim" "$NEUTRON_LOG" 2>/dev/null || true
    fi
    unset _sz
fi
say() {
    printf '%s [%s] %s\n' "$(date '+%F %T')" "$$" "$*" >> "$NEUTRON_LOG" 2>/dev/null || true
}

wine_dir="${NEUTRON_WINE:-}"
if [ -z "$wine_dir" ]; then
    for d in "$HOME/Library/Application Support/Neutron/wine-unified" \
             "$HOME/Library/Application Support/MacNCheese/deps/wine-unified" \
             "${NEUTRON_DEV_WINE:-}"; do
        [ -n "$d" ] && [ -x "$d/loader/wine" ] && wine_dir="$d" && break
    done
fi
[ -n "$wine_dir" ] || { echo "neutron: no unified wine found" >&2; exit 1; }

prefix="${NEUTRON_PREFIX:-$NEUTRON_HOME/prefix}"
stub="$NEUTRON_HOME/bin/steam.exe"
wine="$wine_dir/wine"

[ $# -ge 1 ] || { echo "usage: neutron-run <game.exe> [args...]" >&2; exit 2; }
exe="$1"; shift

# the appid comes from steam's own launch entry. do NOT write steam_appid.txt
# into the game folder: an extra file in a game's bin dir fails its integrity
# check (cs2 reports "some of your files have been modified"). steam_api reads
# SteamAppId from the environment just as happily.
appid="${NEUTRON_APPID:-}"
gdir="$(dirname "$exe")"
[ -n "$appid" ] || { [ -f "$gdir/steam_appid.txt" ] \
    && appid="$(tr -dc 0-9 < "$gdir/steam_appid.txt" || true)"; }

# Unity 2019-era Mono (mono-2.0-bdwgc.dll with no PE TLS directory) JITs dynamic
# TLS as a literal "mov rax,gs:[0x1480+idx*8]", i.e. a raw TEB.TlsSlots read.
# MNC HACK 22 leaves gs.base on Apple's pthread TSD and mirrors only gs:0x30/
# 0x58/0x60, so that read returns 0, Mono derefs 0x10, and its own vectored
# handler re-faults on the same instruction one frame deeper until the 1 MB stack
# is gone ("corrupted thread state, aborting thread"). Unity dies before it ever
# prints "Initialize engine version". Turn HACK 22 off for exactly those games.
# The newer Mono in Unity 2020+ (REPO) reads TlsSlots through a base register,
# which HACK 22 does serve, and it carries a PE TLS directory - that is the test.
# Anything without MonoBleedingEdge (CS2, Galacticverse, every native game) never
# reaches this code.
mono_jit_needs_stock_gs() {
    local dll="$1/MonoBleedingEdge/EmbedRuntime/mono-2.0-bdwgc.dll" lfanew off rva
    [ -f "$dll" ] || return 1
    lfanew="$(od -An -tu4 -j 60 -N4 "$dll" 2>/dev/null | tr -d ' ')"
    [ -n "$lfanew" ] || return 1
    # PE32+ optional header is 0x70 bytes before the data directory; entry 9 = TLS
    off=$(( lfanew + 24 + 0x70 + 72 ))
    rva="$(od -An -tu4 -j "$off" -N4 "$dll" 2>/dev/null | tr -d ' ')"
    [ "${rva:-0}" = 0 ]
}

hack22_off=0
case "${NEUTRON_HACK22_OFF:-auto}" in
    1) hack22_off=1 ;;
    0) hack22_off=0 ;;
    *) mono_jit_needs_stock_gs "$gdir" && hack22_off=1 ;;
esac
if [ "$hack22_off" = 1 ] && [ "${MNC_GAME_BACKEND:-d3dmetal}" = d3dmetal ]; then
    # stock gs.base swapping is what D3DMetal's Apple-framework TSD use conflicts
    # with; with HACK 22 off these games die in GfxDevice on d3dmetal but run on
    # dxvk. Same trade, one direction or the other - pick the one that boots.
    echo "neutron: old-Mono Unity title, using stock gs.base + dxvk" >&2
    MNC_GAME_BACKEND=dxvk
fi

pgrep -x steam_osx >/dev/null 2>&1 || open -ga Steam || true

export WINEPREFIX="$prefix"
export WINEARCH=win64
export MNC_GAME_BACKEND="${MNC_GAME_BACKEND:-d3dmetal}"
# settings, set per game from steam's launch options box
# this wine supports neither, and inheriting one from the caller kills games
export WINEMSYNC=0
export WINEESYNC=0
[ "${NEUTRON_HUD:-0}" = 1 ] && export MTL_HUD_ENABLED=1
[ "${NEUTRON_DEBUG:-0}" = 1 ] && WINEDEBUG="+loaddll,+module,+seh"
# order matters: mnc-d3d (D3DMetal, libd3dshared) first. with only
# /usr/local/lib here, DXVK throws and DXMT renders a black screen.
_deps="$(dirname "$wine_dir")"
if [ -z "${MNC_DYLD:-}" ]; then
    # the engine carries its own freetype/fontconfig/moltenvk/sdl, because a mac
    # with neither macndcheese nor x86_64 homebrew has none of them and wine then
    # cannot find freetype, so no text renders at all
    MNC_DYLD="$wine_dir/mnc-d3d"
    for d in mnc-fonts mnc-tls mnc-vulkan mnc-sdl; do
        [ -d "$wine_dir/$d" ] && MNC_DYLD="$MNC_DYLD:$wine_dir/$d"
    done
    for d in \
        /usr/local/opt/gstreamer/lib /usr/local/lib /usr/local/opt/freetype/lib \
        /usr/local/opt/fontconfig/lib /usr/local/opt/gnutls/lib \
        "$_deps/Wine Stable.app/Contents/Resources/wine/lib" \
        /usr/local/opt/sdl2/lib /usr/local/opt/glib/lib /usr/local/opt/gettext/lib \
        "$_deps/mnc-fonts" "$_deps/mnc-tls" "$_deps/mnc-vulkan" "$_deps/mnc-sdl" /usr/lib; do
        MNC_DYLD="$MNC_DYLD:$d"
    done
fi

# winemetal.so links @rpath/winemac.so and no rpath of its covers
# dlls/winemac.drv/, so DXMT dies in DllMain with 1114 unless something else
# already mapped it. a flat-layout wine has no such dir and is unaffected.
if [ -d "$wine_dir/dlls/winemac.drv" ]; then
    case ":$MNC_DYLD:" in
        *":$wine_dir/dlls/winemac.drv:"*) ;;
        *) MNC_DYLD="$wine_dir/dlls/winemac.drv:$MNC_DYLD" ;;
    esac
fi
export MNC_DYLD

# the rest of what macndcheese passes a game. without these the same game that
# runs there can black-screen or die here.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d;mscoree=;mshtml=;d3dcompiler_47=n,b;nvapi,nvapi64=}"
export ROSETTA_ADVERTISE_AVX=1
export MNC_STEAM_DXMT=1
export MNC_SKIP_WOW64_INSTALL=1
export MNC_CEF_SAFE_MODE=0
export WINE_MAC_GL_CONTEXT_CLAMP=1
export NoDefaultCurrentDirectoryInExePath=1
export WINEDBG=-all
export GST_PLUGIN_SYSTEM_PATH_1_0="${GST_PLUGIN_SYSTEM_PATH_1_0:-/usr/local/opt/gstreamer/lib/gstreamer-1.0}"
export GST_PLUGIN_PATH="${GST_PLUGIN_PATH:-/usr/local/opt/gstreamer/lib/gstreamer-1.0}"
export GST_PLUGIN_FEATURE_RANK="${GST_PLUGIN_FEATURE_RANK:-vtdec:NONE,vtdec_hw:NONE,avdec_h264:MAX,openh264dec:SECONDARY}"
export WINEDEBUG="${WINEDEBUG:--all}"
export FONTCONFIG_PATH="${FONTCONFIG_PATH:-/usr/local/opt/fontconfig/etc/fonts}"

# the shipped mnc-vulkan ICD sets is_portability_driver, which dxvk 1.10.3 never
# opts into, so the loader finds no driver at all. write our own without it.
# the dxgi check uses a command substitution, not "strings | grep -q": under
# pipefail grep exits early, strings takes SIGPIPE and the pipeline returns 141.
# dxmt shaders read their descriptor table from a slot chosen by the airconv that
# is statically linked into winemetal.so. an old winemetal emits index 30 while
# the shipped d3d11_dxmt binds index 1, so every textured draw samples nothing:
# the game is black while every api call reports success. say so rather than
# hand back a black window.
if [ "$MNC_GAME_BACKEND" = "dxmt" ]; then
    _wm="$wine_dir/dlls/winemetal/winemetal.so"
    if [ -f "$_wm" ] && ! nm -a "$_wm" 2>/dev/null | grep -q setup_binding_table2; then
        echo "neutron: this wine has the old winemetal, dxmt renders black. re-run 'neutron install'" >&2
    fi
    unset _wm
fi

if [ "$MNC_GAME_BACKEND" = "dxvk" ]; then
    _dxgi="$prefix/drive_c/windows/system32/dxgi_dxvk.dll"
    if [ ! -f "$_dxgi" ] || [ "$(strings -a "$_dxgi" 2>/dev/null | grep -ci dxvk || true)" = 0 ]; then
        echo "neutron: prefix has the pack's wined3d dxgi, not DXVK's - adapter identity will be wrong; re-run 'neutron install' to stage it" >&2
    fi
    unset _dxgi
fi

if [ "$MNC_GAME_BACKEND" = "dxvk" ]; then
    for _mvk in \
        "$HOME/Library/Application Support/MacNCheese/deps/mnc-vulkan/libMoltenVK.dylib" \
        "$NEUTRON_HOME/mnc-vulkan/libMoltenVK.dylib" \
        "/usr/local/lib/libMoltenVK.dylib"; do
        [ -f "$_mvk" ] || continue
        _icd_dir="$NEUTRON_HOME/vulkan"
        _icd="$_icd_dir/MoltenVK_icd.json"
        mkdir -p "$_icd_dir"
        printf '{\n  "file_format_version": "1.0.0",\n  "ICD": {\n    "library_path": "%s",\n    "api_version": "1.2.0"\n  }\n}\n' \
            "$_mvk" > "$_icd"
        export VK_ICD_FILENAMES="$_icd"
        export VK_DRIVER_FILES="$_icd"
        break
    done
    unset _mvk _icd _icd_dir
fi

if [ "${MNC_GAME_BACKEND:-d3dmetal}" = d3dmetal ] \
   && [ ! -f "$wine_dir/mnc-d3d/libd3dshared.dylib" ]; then
    echo "neutron: D3DMetal is not installed - run 'neutron d3dmetal <toolkit.dmg>', or pick dxvk/dxmt" >&2
fi

# D3DMetal dlopens its framework from next to this dylib. without it ntdll's
# d3d fallback returns STATUS_DLL_NOT_FOUND.
for d in "$wine_dir/mnc-d3d" "$(dirname "$wine_dir")/mnc-d3d"; do
    if [ -f "$d/libd3dshared.dylib" ]; then
        export CX_APPLEGPT_LIBD3DSHARED_PATH="$d/libd3dshared.dylib"
        export CX_APPLEGPTK_LIBD3DSHARED_PATH="$d/libd3dshared.dylib"
        break
    fi
done
[ -n "$appid" ] && export SteamAppId="$appid" SteamGameId="$appid"

# steam_dxmt_redirect in the PE-side ntdll rewrites the dll name per
# MNC_GAME_BACKEND, so stage the pack under its own basenames and leave the
# choice to the variable. adapter per backend, from test/d3dinfo.exe:
#   d3dmetal  AMD Compatibility Mode   opengl  NVIDIA GeForce 6800 (9_3)
#   dxvk      Apple M2 Max (11_0)      dxmt    Apple M2 Max (11_0)

# arch strips DYLD_*, so carry it in MNC_DYLD and re-export past the boundary
run() {
    arch -x86_64 /bin/bash -lc 'export DYLD_FALLBACK_LIBRARY_PATH="$MNC_DYLD"; exec "$@"' bash "$@"
}

STEAM_LOG="$HOME/Library/Application Support/Steam/logs/console_log.txt"
run_dir="$NEUTRON_HOME/run"
mkdir -p "$run_dir" 2>/dev/null || true

tree_pids() {
    local p="$1" c
    for c in $(pgrep -P "$p" 2>/dev/null); do tree_pids "$c"; done
    echo "$p"
}

# the game sits three levels down (arch -> bash -> wine -> exe) and games under
# wine routinely ignore TERM, so signal the whole tree and then insist
stop_tree() {
    local p="$1" i n=0
    if ! kill -0 "$p" 2>/dev/null; then return 0; fi
    for i in $(tree_pids "$p"); do kill -TERM "$i" 2>/dev/null || true; done
    while [ "$n" -lt 20 ]; do
        if ! kill -0 "$p" 2>/dev/null; then return 0; fi
        sleep 0.25
        n=$((n + 1))
    done
    for i in $(tree_pids "$p"); do kill -KILL "$i" 2>/dev/null || true; done
    return 0
}

# one bridge stub per prefix, and steam_stub.c loops forever, so it is found
# rather than started when it is already up. the match is a literal substring:
# pgrep -f reads the install path as a regex, and a home directory containing
# a + or a bracket then reports "not running" and starts a second stub.
stub_running() {
    local line
    while IFS= read -r line; do
        case "$line" in *"$stub"*) return 0 ;; esac
    done < <(ps -axo command= 2>/dev/null)
    return 1
}

game_pid=""
guard_pid=""
appclaim=""
_cleaned=0
# the old version ended on a && that returned non-zero when there was no stub,
# so under errexit the handler died there and the exit never ran
cleanup() {
    if [ "$_cleaned" = 1 ]; then return 0; fi
    _cleaned=1
    if [ -n "$game_pid" ]; then stop_tree "$game_pid"; fi
    if [ -n "$guard_pid" ]; then kill -TERM "$guard_pid" 2>/dev/null || true; fi
    if [ -n "$appclaim" ] && [ "$(head -1 "$appclaim" 2>/dev/null || true)" = "$$" ]; then
        rm -f "$appclaim" 2>/dev/null || true
    fi
    return 0
}
trap 'say "signalled, stopping the game"; cleanup; exit 143' TERM INT HUP
trap cleanup EXIT

# steam never signals this script. on the test machine the launcher outlived both
# the Stop click and steam's own shutdown with no TERM, no KILL and no trap
# firing, and ps showed why steam cannot use the obvious route: it puts the game
# in its own process group, so a group kill would take steam with it. what steam
# does do is print one line the moment it stops counting a process, naming the
# pid it spawned. neutron-launch execs us, so that pid is $$.
guard() {
    # detached from the traps above: this runs on after we are gone, and its own
    # exit must never be what tears the game down
    trap - TERM INT HUP EXIT
    local me="$1" game="$2" from=1 hits
    if [ -f "$STEAM_LOG" ]; then
        from="$(stat -f %z "$STEAM_LOG" 2>/dev/null || echo 0)"
        from=$((from + 1))
    fi
    while :; do
        sleep 2
        # the game ending first is the normal case, and a title that hands off to
        # another process must not be killed for it
        if ! kill -0 "$game" 2>/dev/null; then return 0; fi
        if ! kill -0 "$me" 2>/dev/null; then
            say "launcher was killed outright, taking the game with it"
            stop_tree "$game"
            return 0
        fi
        if [ -f "$STEAM_LOG" ]; then
            # our own ProcID only. steam prints this line for every process a
            # game registers, so acting on a helper or updater exiting would
            # kill the game underneath it. grep -c rather than grep -q: -q exits
            # early, tail takes SIGPIPE and pipefail then reports 141 for a
            # pipeline that actually matched.
            hits="$(tail -c "+$from" "$STEAM_LOG" 2>/dev/null \
                | grep -cE "Game process removed.*ProcID $me( |$)" || true)"
            # if steam itself is gone it did not stop us, it quit, and quitting
            # steam has never meant killing a running game
            if [ "${hits:-0}" -gt 0 ] && pgrep -x steam_osx >/dev/null 2>&1; then
                say "steam stopped counting us, stopping the game"
                stop_tree "$game"
                return 0
            fi
        fi
    done
}

# a Stop that never landed leaves the previous tree orphaned and still burning
# cpu, and steam then starts a second copy on the next Play with no complaint.
# if steam is launching this appid again then an earlier session for the same
# appid is stale by definition. scoped to this appid, so another game running
# under neutron is never touched.
if [ -n "$appid" ]; then
    appclaim="$run_dir/app.$appid"
    _old="$(head -1 "$appclaim" 2>/dev/null || true)"
    case "${_old:-}" in
        ''|*[!0-9]*|"$$") ;;
        *)
            _oldcmd="$(ps -o command= -p "$_old" 2>/dev/null || true)"
            case "$_oldcmd" in
                *neutron-run*)
                    say "previous session for appid $appid still up (pid $_old), stopping it"
                    stop_tree "$_old"
                    ;;
            esac
            unset _oldcmd
            ;;
    esac
    unset _old
    echo "$$" > "$appclaim" 2>/dev/null || appclaim=""
fi

# started detached so it belongs to no launcher. it used to be a child, and the
# EXIT trap of whichever game happened to start it killed the shared bridge out
# from under any other game still running, which then sat at 0% cpu talking to
# nothing.
if ! stub_running; then
    say "starting the steam bridge stub"
    ( run "$wine" "$stub" >/dev/null 2>&1 & )
    sleep 4
fi

# only the game, never the steam.exe stub (the bridge wants HACK 22). the wine
# gate is getenv() != NULL, so unset it rather than exporting a 0.
if [ "$hack22_off" = 1 ]; then export MNC_HACK22_OFF=1; else unset MNC_HACK22_OFF; fi

say "launch pid=$$ ppid=$PPID pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ') backend=$MNC_GAME_BACKEND exe=$exe"

run "$wine" "$exe" "$@" &
game_pid=$!
guard "$$" "$game_pid" &
guard_pid=$!

# errexit would skip the teardown and swallow the reason the game stopped
set +e
wait "$game_pid"
rc=$?
set -e
say "game exited rc=$rc"
cleanup
exit "$rc"
