#!/bin/bash
# neutron - install a proton-like windows-game path into the native mac steam
# client, running through mnc's unified wine. it does not touch the mnc app.
#
#   neutron install [--all]    set up the runtime, back up steam, optionally
#                              wire every installed windows-only game
#   neutron add <appid>        route one game's play button through neutron
#   neutron remove <appid>     undo that
#   neutron status             show what is set up
#   neutron uninstall [--purge]  restore steam, remove neutron (--purge: prefix too)
set -euo pipefail

# these scripts run from inside a signed .app. if python drops __pycache__ next
# to them it breaks the bundle's seal and macos stops opening it.
export PYTHONDONTWRITEBYTECODE=1

HOME_DIR="$HOME"
NEUTRON_HOME="$HOME_DIR/Library/Application Support/Neutron"
BIN="$NEUTRON_HOME/bin"
CONFIG="$NEUTRON_HOME/config"
PREFIX_DEFAULT="$NEUTRON_HOME/prefix"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

STEAM="$HOME_DIR/Library/Application Support/Steam"
STEAM_DEV_CFG="$STEAM/steam_dev.cfg"
COMPAT_DIR="$STEAM/compatibilitytools.d/neutron"
REGISTRY="$STEAM/registry.vdf"
TOOL_NAME="neutron"
DEPLOYED_WINE="$NEUTRON_HOME/wine-unified"
DEPS_WINE="$HOME_DIR/Library/Application Support/MacNCheese/deps/wine-unified"
# only for local dev against a wine build tree; the shipped app never uses it
DEV_WINE="${NEUTRON_DEV_WINE:-}"

die() { echo "neutron: $*" >&2; exit 1; }
note() { echo "  $*"; }

deploy_wine() {
    local src="$1" dst="$2"
    echo "  deploying bundled wine -> $dst" >&2
    mkdir -p "$dst"
    rsync -a --delete "$src/" "$dst/"
}

# the engine used to be unpacked only when there was none at all, so an engine
# from an older release survived every later install. that is how machines ended
# up without mnc-fonts after it was added to the bundle: the directory was never
# there, so neutron-run never put it on the dyld path, wine could not find
# freetype and no text rendered anywhere. the marker file is what says the engine
# on disk is older than the one in the app.
engine_stale() {
    local want have
    want="$(cat "$SELF_DIR/ENGINE" 2>/dev/null || true)"
    [ -n "$want" ] || return 1
    have="$(cat "$NEUTRON_HOME/engine" 2>/dev/null || echo 0)"
    [ "$want" != "$have" ]
}

# D3DMetal is the user's own copy out of apple's toolkit and cannot be fetched
# again from here, so it has to survive the engine being replaced. everything
# else in mnc-d3d ships in the bundle.
D3D_KEEP="D3DMetal.framework libd3dshared.dylib d3d11.dll d3d11_d3dm.dll
dxgi.dll dxgi_d3dm.dll d3d12.dll d3d12_d3dm.dll d3d10_d3dm.dll"

# the .app sets NEUTRON_BUNDLED_WINE to the private wine inside it; we copy it
# out so it survives the app being thrown away. dev machines fall back to the
# deps or build tree.
resolve_wine() {
    if [ -n "${NEUTRON_BUNDLED_WINE:-}" ] && [ -x "$NEUTRON_BUNDLED_WINE/loader/wine" ]; then
        deploy_wine "$NEUTRON_BUNDLED_WINE" "$DEPLOYED_WINE"
        echo "$DEPLOYED_WINE"; return
    fi
    # the shipped app carries the engine as a zip; unpack it once, then it is
    # just a normal wine dir and the app can be thrown away
    if [ -n "${NEUTRON_WINE_ZIP:-}" ] && [ -f "$NEUTRON_WINE_ZIP" ] \
       && { [ ! -x "$DEPLOYED_WINE/loader/wine" ] || engine_stale; }; then
        local keep="" f
        if [ -f "$DEPLOYED_WINE/mnc-d3d/libd3dshared.dylib" ]; then
            keep="$NEUTRON_HOME/.d3dmetal-keep"
            rm -rf "$keep"; mkdir -p "$keep"
            for f in $D3D_KEEP; do
                cp -R "$DEPLOYED_WINE/mnc-d3d/$f" "$keep/" 2>/dev/null || true
            done
        fi
        # check the download before spending minutes on it. a .dmg that arrived
        # truncated fails here with a raw CRC dump from unzip, which reads like a
        # bug in neutron rather than a damaged file.
        if [ -f "$SELF_DIR/ENGINE.sha256" ]; then
            local want have
            want="$(cut -d' ' -f1 < "$SELF_DIR/ENGINE.sha256" 2>/dev/null || true)"
            have="$(shasum -a 256 "$NEUTRON_WINE_ZIP" 2>/dev/null | cut -d' ' -f1)"
            if [ -n "$want" ] && [ "$want" != "$have" ]; then
                if [ -n "$keep" ]; then rm -rf "$keep"; fi
                echo "  this copy of Neutron is damaged: the engine inside it does not" >&2
                echo "  match what was published. download the .dmg again from" >&2
                echo "  github.com/mont127/Neutron/releases" >&2
                echo "  (expected $want, got ${have:-nothing})" >&2
                return 1
            fi
        fi
        echo "  unpacking the wine engine (a few minutes, once)" >&2
        rm -rf "$DEPLOYED_WINE"; mkdir -p "$DEPLOYED_WINE"
        local unpacked=0 missing=""
        if ditto -x -k "$NEUTRON_WINE_ZIP" "$DEPLOYED_WINE" 2>/dev/null \
           || unzip -q "$NEUTRON_WINE_ZIP" -d "$DEPLOYED_WINE"; then
            unpacked=1
            # both tools can report success after extracting only part of a
            # damaged archive, so do not take their word for it
            for f in loader/wine wine server/wineserver mnc-d3d \
                     dlls/lsteamclient/lsteamclient.so; do
                [ -e "$DEPLOYED_WINE/$f" ] || missing="$missing $f"
            done
            [ -z "$missing" ] || unpacked=0
        fi
        if [ "$unpacked" = 1 ]; then
            chmod +x "$DEPLOYED_WINE/loader/wine" "$DEPLOYED_WINE/wine" \
                     "$DEPLOYED_WINE/server/wineserver" 2>/dev/null || true
            # written here, not just in install: d3dmetal and apply both resolve
            # the wine too, and without it they would unpack again every run
            cp "$SELF_DIR/ENGINE" "$NEUTRON_HOME/engine" 2>/dev/null || true
            if [ -n "$keep" ]; then
                for f in $D3D_KEEP; do
                    [ -e "$keep/$f" ] || continue
                    rm -rf "${DEPLOYED_WINE:?}/mnc-d3d/$f"
                    cp -R "$keep/$f" "$DEPLOYED_WINE/mnc-d3d/$f" 2>/dev/null || true
                done
                echo "  kept your D3DMetal files" >&2
            fi
        else
            # do NOT fall through to another wine here. the deps tree belongs to
            # macncheese and has no lsteamclient, so carrying on produced
            # "no lsteamclient in the wine (was it built with the bridge?)",
            # which points at the wrong thing entirely.
            [ -z "$missing" ] || echo "  the engine unpacked incomplete, missing:$missing" >&2
            echo "  could not unpack the engine, so nothing was installed." >&2
            echo "  the download is most likely damaged: fetch the .dmg again from" >&2
            echo "  github.com/mont127/Neutron/releases" >&2
            rm -rf "$DEPLOYED_WINE"
            if [ -n "$keep" ]; then rm -rf "$keep"; fi
            return 1
        fi
        if [ -n "$keep" ]; then rm -rf "$keep"; fi
    fi
    for d in "$DEPLOYED_WINE" "$DEPS_WINE" "$DEV_WINE"; do
        [ -x "$d/loader/wine" ] || continue
        # a wine with no bridge cannot run a steam game, and picking one up
        # silently is how a failed unpack turned into a confusing error later
        if [ -f "$d/dlls/lsteamclient/lsteamclient.so" ] || [ "$d" = "$DEV_WINE" ]; then
            echo "$d"; return
        fi
    done
    return 1
}

# the installer runs wine itself (wineboot to build the prefix, and the registry
# seed), and it used to do that with DYLD_FALLBACK_LIBRARY_PATH=/usr/local/lib.
# a mac without homebrew has no freetype or fontconfig there, so the prefix was
# built by a wine that could not load a font library at all. build the same path
# neutron-run uses, out of the engine's own copies.
engine_dyld() {
    local wine="$1" p d
    p="$wine/mnc-d3d"
    for d in mnc-fonts mnc-tls mnc-vulkan mnc-sdl; do
        if [ -d "$wine/$d" ]; then p="$p:$wine/$d"; fi
    done
    if [ -d "$wine/dlls/winemac.drv" ]; then p="$wine/dlls/winemac.drv:$p"; fi
    for d in /usr/local/lib /usr/local/opt/freetype/lib \
             /usr/local/opt/fontconfig/lib /usr/local/opt/gnutls/lib /usr/lib; do
        p="$p:$d"
    done
    echo "$p"
}

# drive_c is a poor test for "this prefix exists": anything that creates a
# directory inside it makes the test pass, and wineboot then never runs. even
# system.reg is not enough, because a prefix that wine half-initialised at launch
# has one while system32 holds nothing but the dlls we staged. kernel32 is put
# there by wineboot and by nothing else here.
prefix_ready() {
    [ -f "$1/system.reg" ] && [ -f "$1/drive_c/windows/system32/kernel32.dll" ]
}

# when wine initialises a prefix itself it assigns drive letters from whatever is
# mounted, and with no c: yet it will hand C: to the first volume it finds. on a
# machine installing from the .dmg that is the Neutron disk image, and every
# launch afterwards dies with "could not open working directory C:\windows\".
fix_c_drive() {
    local prefix="$1" cur
    [ -d "$prefix/dosdevices" ] || return 0
    cur="$(readlink "$prefix/dosdevices/c:" 2>/dev/null || true)"
    case "$cur" in
        ../drive_c|"$prefix/drive_c") return 0 ;;
    esac
    ln -sfn ../drive_c "$prefix/dosdevices/c:" 2>/dev/null || return 0
    rm -f "$prefix/dosdevices/c::" 2>/dev/null || true
    note "repaired the C: drive, it pointed at ${cur:-nothing}"
}

# the bridge ships inside the unified wine; only fall back to the build tree
bridge_src() {
    local wine="$1" b
    for b in "$wine/dlls/lsteamclient" "$DEV_WINE/dlls/lsteamclient"; do
        [ -f "$b/lsteamclient.so" ] && { echo "$b"; return; }
    done
    return 1
}

steam_running() { pgrep -x steam_osx >/dev/null 2>&1; }

# --- build the stub steam.exe -------------------------------------------------

# the shipped .app carries a prebuilt stub so it needs no compiler; a dev
# checkout builds it from source if mingw is around
provide_stub() {
    mkdir -p "$BIN"
    if [ -f "$SELF_DIR/prebuilt/steam.exe" ]; then
        cp "$SELF_DIR/prebuilt/steam.exe" "$BIN/steam.exe"
        [ -f "$SELF_DIR/prebuilt/steam32.exe" ] && cp "$SELF_DIR/prebuilt/steam32.exe" "$BIN/steam32.exe"
        note "installed prebuilt steam stub"
    elif command -v x86_64-w64-mingw32-gcc >/dev/null; then
        x86_64-w64-mingw32-gcc -static -O2 -o "$BIN/steam.exe" "$SELF_DIR/src/steam_stub.c" -ladvapi32
        command -v i686-w64-mingw32-gcc >/dev/null && \
            i686-w64-mingw32-gcc -static -O2 -o "$BIN/steam32.exe" "$SELF_DIR/src/steam_stub.c" -ladvapi32
        note "built steam stub"
    else
        die "no prebuilt stub and no mingw to build one"
    fi
}

# --- stage the bridge into wine + prefix -------------------------------------

stage_bridge() {
    local wine="$1" prefix="$2" src dst="$wine/dlls/lsteamclient"
    src="$(bridge_src "$wine")" || die "no lsteamclient in the wine (was it built with the bridge?)"

    # the bundled wine already carries the bridge; only copy it in when it came
    # from somewhere else (a dev build tree)
    if [ "$src" != "$dst" ]; then
        mkdir -p "$dst/x86_64-windows" "$dst/i386-windows"
        cp "$src/lsteamclient.so" "$dst/"
        cp "$src/x86_64-windows/lsteamclient.dll" "$dst/x86_64-windows/"
        [ -f "$src/i386-windows/lsteamclient.dll" ] && cp "$src/i386-windows/lsteamclient.dll" "$dst/i386-windows/"
    fi

    # never build this tree ourselves when wineboot has not run: a drive_c that
    # exists is exactly what stopped wineboot from ever running, and wine then
    # initialised the prefix at launch and gave C: to a mounted disk image
    if ! prefix_ready "$prefix"; then
        note "prefix is not built, bridge not staged"
        return 0
    fi

    # into the prefix so LoadLibrary and the registry path find the pe
    # proton copies the bridge into C:\Program Files (x86)\Steam under steam's own
    # dll names; a game then loads a module called steamclient64.dll from the
    # path it expects instead of an unknown lsteamclient.dll in system32
    local sdir="$prefix/drive_c/Program Files (x86)/Steam"
    mkdir -p "$sdir"
    cp "$src/x86_64-windows/lsteamclient.dll" "$sdir/steamclient64.dll"
    [ -f "$src/i386-windows/lsteamclient.dll" ] && \
        cp "$src/i386-windows/lsteamclient.dll" "$sdir/steamclient.dll"
    [ -f "$BIN/steam.exe" ] && cp "$BIN/steam.exe" "$sdir/steam.exe"

    # an unguarded cp into a system32 that wineboot never created aborted the
    # whole install here, under errexit, with no message
    mkdir -p "$prefix/drive_c/windows/system32" "$prefix/drive_c/windows/syswow64" 2>/dev/null || true
    cp "$src/x86_64-windows/lsteamclient.dll" "$prefix/drive_c/windows/system32/lsteamclient.dll"
    [ -f "$src/i386-windows/lsteamclient.dll" ] && \
        cp "$src/i386-windows/lsteamclient.dll" "$prefix/drive_c/windows/syswow64/lsteamclient.dll"
    note "staged bridge into prefix"
}

# --- graphics dlls ------------------------------------------------------------
# the unified wine ships its d3d builtins DISABLED and expects the real ones
# staged into the prefix from mnc-d3d; the loader then routes each process to the
# right variant. without this every dx game fails to start with error 126.

d3d_pack_dir() {
    local wine="$1"
    for d in "$wine/mnc-d3d" "$(dirname "$wine")/mnc-d3d"; do
        [ -d "$d" ] && { echo "$d"; return; }
    done
    return 1
}

stage_d3d() {
    local wine="$1" prefix="$2" pack sys32 n=0 bad=0 f
    pack="$(d3d_pack_dir "$wine")" || { note "no mnc-d3d pack, dx games will not start"; return 0; }
    sys32="$prefix/drive_c/windows/system32"
    # same reason as the bridge: do not conjure drive_c. when wineboot had not
    # built the prefix, every cp here used to fail and the only sign was
    # "staged 0 graphics dlls" going past, so say it plainly instead
    if ! prefix_ready "$prefix"; then
        note "prefix is not built, no graphics dlls staged and dx games will not start"
        return 0
    fi
    mkdir -p "$sys32" 2>/dev/null || true
    for f in "$pack"/*.dll; do
        [ -f "$f" ] || continue
        if cp "$f" "$sys32/$(basename "$f")" 2>/dev/null; then
            n=$((n + 1))
        else
            bad=$((bad + 1))
        fi
    done
    [ "$bad" = 0 ] || note "could not stage $bad graphics dll(s) into $sys32"
    note "staged $n graphics dlls from $(basename "$pack")"

    if ! d3dmetal_present "$wine"; then
        note "D3DMetal is not installed. it is apple's and cannot be shipped, so"
        note "download the Game Porting Toolkit ('Evaluation environment for"
        note "Windows games') from developer.apple.com and run:"
        note "    neutron d3dmetal /path/to/Evaluation_environment_*.dmg"
        note "until then use the dxvk or dxmt backend."
    fi

    # dxmt caches compiled shaders per exe and keys them on its own version only,
    # not on which airconv built them. an upgrade that changes the shader abi
    # leaves stale AIR behind, which renders black. cheap to rebuild, so drop it.
    local dxcache
    dxcache="$(getconf DARWIN_USER_CACHE_DIR 2>/dev/null)dxmt"
    if [ -d "$dxcache" ]; then
        rm -rf "$dxcache" && note "cleared the dxmt shader cache"
    fi

    # the pack's dxgi_dxvk.dll is not DXVK at all -- it is wine's wined3d dxgi
    # (0 dxvk strings, 2672 wined3d strings, imports wined3d.dll). DXVK's d3d11
    # then warns "Adapter is not a DXVK adapter" and reports a fake
    # "NVIDIA GeForce 6800" identity that games use to pick presets and VRAM
    # budgets. Overlay the real DXVK 1.10.3 dxgi from the same build session
    # that produced the pack's d3d11_dxvk.dll (md5-identical), into the PREFIX
    # only -- never into the read-only mnc-d3d pack.
    if [ -f "$SELF_DIR/vendor/dxvk-1.10.3/x86_64/dxgi.dll" ]; then
        cp "$SELF_DIR/vendor/dxvk-1.10.3/x86_64/dxgi.dll" "$sys32/dxgi_dxvk.dll" \
            && note "staged real DXVK dxgi over the pack's wined3d one"
    fi
}

# --- d3dmetal from apple's toolkit ------------------------------------------
# D3DMetal is Apple's, under a licence that does not allow redistribution, so it
# is NOT bundled. point neutron at the "Evaluation environment for Windows games"
# disk image (or an already-extracted redist dir) and the pieces are copied into
# the engine under the names the loader expects. mapping verified by hash against
# a known-good pack: one GPTK dll serves both the canonical and the _d3dm slot.

d3dmetal_present() {
    local pack
    pack="$(d3d_pack_dir "$1")" || return 1
    [ -e "$pack/D3DMetal.framework" ] && [ -f "$pack/libd3dshared.dylib" ] \
        && [ -f "$pack/d3d11_d3dm.dll" ]
}

cmd_d3dmetal() {
    local src="${1:-}" wine pack redist mp="" rc=0
    [ -n "$src" ] || die "usage: neutron d3dmetal <Evaluation_environment_for_Windows_games_*.dmg | redist dir>"
    [ -e "$src" ] || die "no such file: $src"
    wine="$(resolve_wine)" || die "the wine engine is not available, see the lines above"
    pack="$(d3d_pack_dir "$wine")" || die "no mnc-d3d dir in the engine"

    if [ "${src##*.}" = "dmg" ]; then
        mp="$(hdiutil attach "$src" -nobrowse -readonly 2>/dev/null | grep -o '/Volumes/.*' | head -1)"
        [ -n "$mp" ] || die "could not mount $src"
        redist="$mp/redist"
    else
        redist="$src"
        [ -d "$redist/lib" ] || redist="$src/redist"
    fi

    local ext="$redist/lib/external" win="$redist/lib/wine/x86_64-windows"
    if [ ! -d "$ext" ] || [ ! -d "$win" ]; then
        [ -n "$mp" ] && hdiutil detach "$mp" -quiet 2>/dev/null
        die "that does not look like the toolkit (no redist/lib/external)"
    fi

    rm -rf "$pack/D3DMetal.framework"
    cp -R "$ext/D3DMetal.framework" "$pack/D3DMetal.framework" || rc=1
    cp "$ext/libd3dshared.dylib" "$pack/libd3dshared.dylib" || rc=1
    note "installed D3DMetal.framework + libd3dshared.dylib"

    # one source dll fills both slots: canonical is the default a game falls to,
    # _d3dm is where the loader routes the d3dmetal backend explicitly
    local n=0
    _put() { [ -f "$win/$1" ] && { cp "$win/$1" "$pack/$2" && n=$((n + 1)); }; }
    _put d3d11.dll d3d11.dll;  _put d3d11.dll d3d11_d3dm.dll
    _put dxgi.dll  dxgi.dll;   _put dxgi.dll  dxgi_d3dm.dll
    _put d3d12.dll d3d12.dll;  _put d3d12.dll d3d12_d3dm.dll
    _put d3d10.dll d3d10_d3dm.dll
    unset -f _put
    note "installed $n d3dmetal dlls"

    [ -n "$mp" ] && hdiutil detach "$mp" -quiet 2>/dev/null
    [ "$rc" = 0 ] || die "copy failed"

    # push them into the prefix too so the next launch picks them up
    [ -d "$PREFIX_DEFAULT/drive_c" ] && stage_d3d "$wine" "$PREFIX_DEFAULT"
    note "d3dmetal ready"
}

# --- fonts --------------------------------------------------------------------
# a fresh prefix has an empty Fonts dir, so wine falls back to its own free
# fonts and anything asking for arial/tahoma/times draws tofu boxes or nothing.
# macOS already ships the microsoft core fonts in Supplemental, so copy the
# user's own copies in rather than redistributing them. wine registers any ttf
# dropped in that directory on next start. idempotent, and a no-op if a prefix
# already has them.

install_fonts() {
    # one `local` expands every argument before assigning any, so fonts cannot
    # be built from prefix on the same line
    local prefix="$1" n=0 f fonts
    fonts="$prefix/drive_c/windows/Fonts"
    mkdir -p "$fonts"
    if [ -f "$fonts/Arial.ttf" ] || [ -f "$fonts/arial.ttf" ]; then return 0; fi

    local fam=(Arial "Arial Black" "Arial Narrow" "Times New Roman" "Courier New"
               Georgia Verdana "Trebuchet MS" "Comic Sans MS" Impact Webdings
               Wingdings "Andale Mono" Tahoma)
    local dir name
    for dir in /System/Library/Fonts/Supplemental /Library/Fonts; do
        [ -d "$dir" ] || continue
        for name in "${fam[@]}"; do
            for f in "$dir/$name"*.ttf "$dir/$name"*.ttc; do
                [ -f "$f" ] || continue
                [ -f "$fonts/$(basename "$f")" ] && continue
                cp "$f" "$fonts/" 2>/dev/null && n=$((n + 1))
            done
        done
    done

    # anything the system does not have can still come from a bundled pack
    local cf="$DEPS_WINE/../redist/corefonts"
    if [ -d "$cf" ]; then
        for f in "$cf"/*.ttf "$cf"/*.TTF; do
            [ -f "$f" ] || continue
            [ -f "$fonts/$(basename "$f")" ] && continue
            cp "$f" "$fonts/" 2>/dev/null && n=$((n + 1))
        done
    fi

    [ "$n" -gt 0 ] && note "installed $n fonts into the prefix"
    return 0
}

# --- steam play compatibility tool -------------------------------------------
# this is how proton does it: register a compat tool, then map it in the
# registry. steam then offers Install for windows-only titles and launches them
# through us, no platform override and no shortcuts needed.

install_compat_tool() {
    mkdir -p "$COMPAT_DIR"
    cp "$SELF_DIR/src/compat-entry" "$COMPAT_DIR/compat-entry"
    chmod +x "$COMPAT_DIR/compat-entry"

    cat > "$COMPAT_DIR/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
	"compat_tools"
	{
		"$TOOL_NAME"
		{
			"install_path"	"."
			"display_name"	"Neutron"
			"from_oslist"	"windows"
			"to_oslist"	"macos"
		}
	}
}
EOF

    cat > "$COMPAT_DIR/toolmanifest.vdf" <<'EOF'
"manifest"
{
	"version"	"2"
	"commandline"	"/compat-entry %verb%"
	"compatmanager_layer_name"	"neutron"
}
EOF
    note "registered steam play tool in $COMPAT_DIR"
}

# appid 0 is the global default: every windows-only title becomes installable
map_compat_tool() {
    local appid="${1:-0}"
    [ -f "$REGISTRY" ] || die "no registry.vdf, has steam ever run?"
    cp "$REGISTRY" "$NEUTRON_HOME/registry.vdf.bak" 2>/dev/null || true
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" set "$REGISTRY" "$appid" "$TOOL_NAME" \
        || die "could not write CompatToolMapping"
    [ "$appid" = 0 ] && note "steam play enabled for all windows titles" \
                     || note "steam play enabled for appid $appid"
}

unmap_compat_tool() {
    local appid="${1:-0}"
    [ -f "$REGISTRY" ] && PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" clear "$REGISTRY" "$appid" || true
}

# --- depot downloads ---------------------------------------------------------
# steam's console download_depot ignores the client platform, so windows depots
# come down on a mac with no override and no risk to native games. it stages
# them inside the client bundle, so we move them out afterwards.

depot_staging_dir() {
    echo "$STEAM/Steam.AppBundle/Steam/Contents/MacOS/steamapps/content/app_$1/depot_$2"
}

# console_log.txt is months deep and never truncated, so only look at lines
# written AFTER we asked for this depot - otherwise an old "complete" line makes
# every re-download look instantly finished.
# usage: wait_for_depot <appid> <depot> <log-lines-before-we-started> [cap]
wait_for_depot() {
    local appid="$1" depot="$2" tail_from="${3:-0}" cap="${4:-7200}" waited=0
    local log="$STEAM/logs/console_log.txt" dir new
    dir="$(depot_staging_dir "$appid" "$depot")"
    while [ "$waited" -lt "$cap" ]; do
        new="$(tail -n +"$((tail_from + 1))" "$log" 2>/dev/null)"
        case "$new" in
            *"Depot download complete"*"depot_$depot"*) echo; return 0 ;;
        esac
        # steam words depot failures several ways; match the family, not one string
        case "$new" in
            *"depot $depot"*[Ff]ail*|*"Failed to download"*|*"download failed"*|*"Error: "*"depot"*)
                echo; return 1 ;;
        esac
        [ -d "$dir" ] && printf "\r    %-44s" "$(du -sh "$dir" 2>/dev/null | cut -f1) downloaded"
        sleep 5
        waited=$((waited + 5))
    done
    echo
    return 1
}

find_game_exe() {
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/findexe.py" "$1" 2>/dev/null
}

# one library entry per game whose Play button runs neutron-play <appid>,
# which installs on first click and launches after that.
wire_shortcut() {
    local name="$1" appid="$2" base="${3:-$NEUTRON_HOME/games}" cfg wrote=0 exe
    # already downloaded? record the exe so the Play button launches instead of
    # re-downloading
    if [ ! -f "$NEUTRON_HOME/games/.map/$appid" ] && [ -d "$NEUTRON_HOME/games/$name" ]; then
        exe="$(find_game_exe "$NEUTRON_HOME/games/$name")"
        [ -n "$exe" ] && { mkdir -p "$NEUTRON_HOME/games/.map"; echo "$exe" > "$NEUTRON_HOME/games/.map/$appid"; }
    fi
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" add "$cfg/shortcuts.vdf" "$name" \
            "\"$BIN/neutron-play\"" "$base" "$appid" && wrote=1
    done < <(configdirs)
    [ "$wrote" = 1 ] || die "no steam user config dir found"
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/artwork.py" \
        "$STEAM" "$appid" "$name" "$BIN/neutron-play" >/dev/null 2>&1 || true
    note "shortcut: $name (installs + plays)"
}

wire_exe() {
    local name="$1" exe="$2" appid="${3:-}"
    [ -n "$appid" ] || die "wire_exe needs an appid"
    # deliberately NOT writing steam_appid.txt into the game folder: an extra
    # file in a game's bin dir fails its integrity check. the appid is passed
    # to neutron-run in the environment instead.
    wire_shortcut "$name" "$appid" "$([ -n "$exe" ] && dirname "$exe" || echo "$NEUTRON_HOME/games")"
}

# --- steam launch options ----------------------------------------------------

configdirs() {
    find "$STEAM/userdata" -maxdepth 2 -type d -name config 2>/dev/null
}

# non-steam shortcut through neutron-run. drops steam_appid.txt next to the exe
# so the game reports to the right appid, and writes the shortcut for every user.
wire_game() {
    local appid="$1" info base exe name
    info="$(PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/gameexe.py" "$STEAM" "$appid")" || \
        die "appid $appid is not installed (get it first: neutron get $appid)"
    base="${info%%|*}"; name="${info##*|}"; exe="${info#*|}"; exe="${exe%|*}"
    [ -n "$exe" ] && [ -f "$exe" ] || die "could not find the windows exe for $appid under $base"
    mkdir -p "$NEUTRON_HOME/games/.map"; echo "$exe" > "$NEUTRON_HOME/games/.map/$appid"
    wire_exe "$name" "$exe" "$appid"
}

unwire_game() {
    local appid="$1" name cfg
    name="$(game_name "$appid" 2>/dev/null)"
    [ -n "$name" ] || return 0
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" remove "$cfg/shortcuts.vdf" "$name" || true
    done < <(configdirs)
    rm -f "$NEUTRON_HOME/games/.map/$appid"
}

backup_steam() {
    local cfg f rel
    mkdir -p "$NEUTRON_HOME/steam-backup"
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        for f in "$cfg/localconfig.vdf" "$cfg/shortcuts.vdf"; do
            [ -f "$f" ] || continue
            rel="$(echo "$f" | sed "s#$STEAM/##; s#/#_#g")"
            [ -f "$NEUTRON_HOME/steam-backup/$rel" ] || cp "$f" "$NEUTRON_HOME/steam-backup/$rel"
        done
    done < <(configdirs)
    note "backed up steam config"
}

# --- classification: prefer macos, neutron only for windows-only -------------

classify() {
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/classify.py" "$STEAM" "$@"
}

game_verdict() { classify "$1" | head -1 | cut -d'|' -f2; }

installed_windows_games() {
    classify | awk -F'|' '$2 == "windows-only" { print $1 }'
}

# --- subcommands -------------------------------------------------------------

cmd_install() {
    local wine prefix all=0
    [ "${1:-}" = "--all" ] && all=1
    wine="$(resolve_wine)" || die "the wine engine is not available, see the lines above"
    prefix="$PREFIX_DEFAULT"
    echo "installing neutron (wine: $wine)"

    mkdir -p "$BIN"
    provide_stub
    # deploy the whole tool so a shortcut's Play button can drive installs even
    # after the original checkout / .app is gone
    mkdir -p "$NEUTRON_HOME/app"
    cp -R "$SELF_DIR/src" "$NEUTRON_HOME/app/"
    cp "$SELF_DIR/neutron" "$SELF_DIR/neutron-run" "$SELF_DIR/src/neutron-play" \
       "$SELF_DIR/src/neutron-watch" "$NEUTRON_HOME/app/" 2>/dev/null || \
        cp "$SELF_DIR/neutron" "$SELF_DIR/neutron-run" "$NEUTRON_HOME/app/"
    chmod +x "$NEUTRON_HOME/app/neutron" "$NEUTRON_HOME/app/neutron-run"
    cp "$SELF_DIR/VERSION" "$NEUTRON_HOME/version" 2>/dev/null || echo 0 > "$NEUTRON_HOME/version"
    cp "$SELF_DIR/ENGINE"  "$NEUTRON_HOME/engine"  2>/dev/null || echo 0 > "$NEUTRON_HOME/engine"
    [ -f "$NEUTRON_HOME/app/neutron-watch" ] && chmod +x "$NEUTRON_HOME/app/neutron-watch"
    cp "$SELF_DIR/neutron-run" "$BIN/neutron-run"
    cp "$SELF_DIR/src/neutron-play" "$BIN/neutron-play"
    chmod +x "$BIN/neutron-run" "$BIN/neutron-play"

    MNC_DYLD="$(engine_dyld "$wine")"; export MNC_DYLD
    # before wineboot as well as after: a prefix left over from 0.7 has C:
    # pointing at a mounted disk image, and repairing a prefix through that is
    # not something to find out about afterwards
    fix_c_drive "$prefix"
    # a prefix that wine half-initialised at launch cannot be repaired in place:
    # wineboot reads a current-looking system.reg, skips the update, and system32
    # keeps nothing but the dlls we staged, so nothing will ever run. build a new
    # one and bring the user's files across.
    if [ -d "$prefix" ] && ! prefix_ready "$prefix"; then
        note "prefix is damaged, rebuilding it"
        rm -rf "$prefix.damaged"
        mv "$prefix" "$prefix.damaged" 2>/dev/null || true
    fi
    if ! prefix_ready "$prefix"; then
        note "creating prefix $prefix"
        WINEPREFIX="$prefix" WINEARCH=win64 WINEDEBUG=-all \
            arch -x86_64 /bin/bash -lc 'export DYLD_FALLBACK_LIBRARY_PATH="$MNC_DYLD"; exec "$0" wineboot --init' "$wine/wine" >/dev/null 2>&1 || true
        # wineboot returns before the prefix has finished filling itself in, and
        # everything below reads it
        local _w=0
        while [ "$_w" -lt 20 ]; do
            prefix_ready "$prefix" && break
            sleep 1
            _w=$((_w + 1))
        done
        if [ -d "$prefix.damaged/drive_c/users" ] && [ -d "$prefix/drive_c/users" ]; then
            cp -R "$prefix.damaged/drive_c/users/." "$prefix/drive_c/users/" 2>/dev/null || true
            note "carried your saved data over from the old prefix"
        fi
    fi
    if ! prefix_ready "$prefix"; then
        note "wineboot did not build $prefix, so games will not start"
    fi
    fix_c_drive "$prefix"

    stage_bridge "$wine" "$prefix"
    stage_d3d "$wine" "$prefix"
    install_fonts "$prefix"

    # seed the registry once so steam_api can find the client dll before a run
    WINEPREFIX="$prefix" WINEDEBUG=-all \
        arch -x86_64 /bin/bash -lc 'export DYLD_FALLBACK_LIBRARY_PATH="$MNC_DYLD"; exec "$0" "$1" --once' "$wine/wine" "$BIN/steam.exe" >/dev/null 2>&1 || true

    cat > "$CONFIG" <<EOF
NEUTRON_WINE="$wine"
NEUTRON_PREFIX="$prefix"
EOF
    note "wrote $CONFIG"

    backup_steam
    install_compat_tool
    install_runtime
    # neutron rides along with steam from here on: the watcher keeps every
    # windows game's overlay in place, including newly bought ones
    cmd_autosync on >/dev/null 2>&1 && note "auto-sync running alongside steam"
    if steam_running; then
        echo
        echo "installed. quit steam and run 'neutron enable-all' once, then start"
        echo "steam: your windows games get their own Install and Play buttons."
    else
        map_compat_tool 0
        echo
        echo "done. run 'neutron enable-all', then start steam: windows-only games"
        echo "now have their own Install button and launch through neutron."
    fi
}

cmd_add() {
    local appid="" force=0 a
    for a in "$@"; do
        case "$a" in --force) force=1 ;; *) appid="$a" ;; esac
    done
    [ -n "$appid" ] || die "usage: neutron add <appid> [--force]"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    local verdict; verdict="$(game_verdict "$appid")"
    if [ "$verdict" = "native-ok" ] && [ "$force" != 1 ]; then
        die "appid $appid has a macOS build, Steam runs it natively. use --force to route it through neutron anyway."
    fi
    steam_running && die "close steam first (it rewrites its config on exit)"
    backup_steam
    wire_game "$appid"
    echo "added. restart steam and launch \"$(game_name "$appid")\" from your library."
}

game_name() { classify "$1" | head -1 | cut -d'|' -f5; }

cmd_enable() {
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "quit steam first, then run: neutron enable"
    [ -d "$COMPAT_DIR" ] || install_compat_tool
    map_compat_tool "${1:-0}"
    echo "start steam. windows-only games now show Install and run through neutron."
}

cmd_disable() {
    steam_running && die "quit steam first, then run: neutron disable"
    unmap_compat_tool "${1:-0}"
    echo "steam play mapping removed. restart steam."
}

# wire any windows exe, in the steam library or not
cmd_add_exe() {
    local name="${1:-}" exe="${2:-}" appid="${3:-}"
    [ -n "$name" ] && [ -n "$exe" ] || die "usage: neutron add-exe <name> <exe.path> [appid]"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "close steam first (it rewrites its config on exit)"
    backup_steam
    wire_exe "$name" "$exe" "$appid"
    echo "added \"$name\". restart steam and launch it from your library."
}

# a shortcut for every windows-only game you own. steam must be closed.
cmd_wire_all() {
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "quit steam first, then run: neutron wire-all"
    backup_steam
    local n=0 id verdict action inst name
    while IFS='|' read -r id verdict action inst name; do
        [ "$action" = "neutron" ] || continue
        wire_shortcut "$name" "$id" >/dev/null 2>&1 && n=$((n + 1))
    done < <(classify)
    echo "put $n windows game(s) in your steam library. restart steam; each has a"
    echo "Play button that downloads on first click, then launches."
}


# make steam treat an already-downloaded windows game as a real install, so its
# library page shows Play instead of a greyed Install. writes an appmanifest and
# points the launch target at a shim script, which macOS will run whatever its
# extension, and that hands the exe to neutron-run.
cmd_adopt() {
    local appid="${1:-}" name gdir
    [ -n "$appid" ] || die "usage: neutron adopt <appid>"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "quit steam first, then run: neutron adopt $appid"
    name="$(game_name "$appid")"
    gdir="$NEUTRON_HOME/games/$name"
    [ -d "$gdir" ] || die "$name is not downloaded yet (neutron get $appid)"
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/adopt.py" apply \
        "$STEAM" "$appid" "$gdir" "$BIN/neutron-run" || die "adopt failed"
    # steam owns the files now; keep the map pointing at the real exe
    local real
    real="$(find "$STEAM/steamapps/common" -name "*.neutron" -maxdepth 3 2>/dev/null | head -1)"
    [ -n "$real" ] && { mkdir -p "$NEUTRON_HOME/games/.map"; echo "$real" > "$NEUTRON_HOME/games/.map/$appid"; }
    echo
    echo "steam now treats $name as installed. start steam - its own page should"
    echo "show Play, and clicking it runs the game through neutron."
}

cmd_unadopt() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron unadopt <appid>"
    steam_running && die "quit steam first"
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/adopt.py" revert "$STEAM" "$appid"
    echo "steam no longer treats appid $appid as installed."
}


APPINFO="$STEAM/appcache/appinfo.vdf"

# steam resolves a launch entry relative to the library the game landed in, so
# the shim goes in all of them
install_runtime() {
    local lib dst
    { echo "$STEAM"; sed -n 's/.*"path"[[:space:]]*"\(.*\)".*/\1/p' \
        "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null; } | sort -u | while IFS= read -r lib; do
        [ -n "$lib" ] || continue
        # an unplugged external library is still listed in libraryfolders.vdf.
        # skipping it silently is how a game ends up with no shim at all, which
        # steam reports as "missing game executable" and nothing explains
        if [ ! -d "$lib" ]; then
            echo "  library not reachable, games on it will not launch: $lib" >&2
            continue
        fi
        # do NOT require steamapps/common to exist: a steam that has never
        # downloaded a game has no such dir, the runtime would be skipped, and
        # the first game installed would fail with "missing game executable"
        dst="$lib/steamapps/common/Neutron Runtime"
        if mkdir -p "$dst" 2>/dev/null \
           && cp "$SELF_DIR/src/neutron-launch" "$dst/.neutron-launch.new" 2>/dev/null \
           && chmod +x "$dst/.neutron-launch.new" 2>/dev/null \
           && mv -f "$dst/.neutron-launch.new" "$dst/neutron-launch" 2>/dev/null; then
            echo "  runtime -> $lib"
        else
            rm -f "$dst/.neutron-launch.new" 2>/dev/null || true
            echo "  cannot write the runtime into $lib" >&2
        fi
    done || true
    # one unwritable library must not abort the whole apply: under errexit an
    # unguarded cp in here used to kill neutron outright, with no message, and
    # every library after it went without a shim
    return 0
}

# tell steam a windows-only game also has a macOS build, which is our shim.
# --force is for games that DO have a mac build we do not want: cs2 ships the
# legacy CS:GO mac build, so steam installs that instead of real cs2.
cmd_enable_game() {
    local appid="" force=""
    for a in "$@"; do
        case "$a" in --force) force="--force" ;; *) appid="$a" ;; esac
    done
    [ -n "$appid" ] || die "usage: neutron enable-game <appid> [--force]"
    steam_running && die "quit steam first, then run: neutron enable-game $appid"
    [ -f "$APPINFO" ] || die "no appinfo cache"
    mkdir -p "$NEUTRON_HOME/backup"
    [ -f "$NEUTRON_HOME/backup/appinfo.orig.vdf" ] || cp "$APPINFO" "$NEUTRON_HOME/backup/appinfo.orig.vdf"
    install_runtime >/dev/null
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" enable "$APPINFO" "$appid" ${force:+--force} | sed 's/^/  /'
}

# same for every windows-only game you own
cmd_enable_all() {
    steam_running && die "quit steam first, then run: neutron enable-all"
    [ -f "$APPINFO" ] || die "no appinfo cache"
    mkdir -p "$NEUTRON_HOME/backup"
    [ -f "$NEUTRON_HOME/backup/appinfo.orig.vdf" ] || cp "$APPINFO" "$NEUTRON_HOME/backup/appinfo.orig.vdf"
    install_runtime
    local n=0 back=0 id verdict action inst name
    while IFS='|' read -r id verdict action inst name; do
        # a game we should never have touched: hand it back. the oslist parser
        # read "windows, macos" as windows-only because of the space, so a game
        # with a real mac build could end up going through wine
        if [ "$action" = "macos" ] && overlay_present "$id"; then
            if PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" revert \
                 "$APPINFO" "$id" "$NEUTRON_HOME/backup/appinfo.orig.vdf" >/dev/null 2>&1; then
                back=$((back + 1))
                note "gave $name back to its own macOS build"
            fi
            continue
        fi
        [ "$action" = "neutron" ] || continue
        if PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" enable "$APPINFO" "$id" >/dev/null 2>&1; then
            n=$((n + 1))
        fi
    done < <(classify)
    [ "$back" = 0 ] || echo "put $back game(s) back on their own macOS build."
    echo "enabled $n windows game(s) inside steam."
    echo "start steam: each now has its own Install button, and Play runs it through neutron."
}

# a persistent default per game. steam's Launch Options box overrides it.
cmd_set() {
    local appid="${1:-}" kv
    [ -n "$appid" ] || die "usage: neutron set <appid> backend=dxmt hud=1"
    shift
    mkdir -p "$NEUTRON_HOME/games/.cfg"
    local f="$NEUTRON_HOME/games/.cfg/$appid"
    : > "$f"
    for kv in "$@"; do
        case "$kv" in
            backend=*) echo "export MNC_GAME_BACKEND=${kv#backend=}" >> "$f" ;;
            hud=*)     echo "export NEUTRON_HUD=${kv#hud=}" >> "$f" ;;
            debug=*)   echo "export NEUTRON_DEBUG=${kv#debug=}" >> "$f" ;;
            *) die "unknown setting: $kv (backend|hud|debug)" ;;
        esac
    done
    echo "settings for $appid:"; sed 's/^export /  /' "$f"
}


# up to date, not merely present: an overlay from an older neutron gets
# refreshed, so fixes reach games that are already enabled
overlay_present() {
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" check "$APPINFO" "$1" >/dev/null 2>&1
}

# re-apply the overlay to any windows game missing it. does nothing unless
# something needs fixing, and refuses to touch appinfo while steam is running,
# because steam overwrites it on exit.
cmd_sync() {
    local quiet=0
    [ "${1:-}" = "--quiet" ] && quiet=1
    [ -f "$CONFIG" ] || exit 0
    [ -f "$APPINFO" ] || exit 0
    if steam_running; then
        [ "$quiet" = 1 ] && exit 0
        die "steam is running - quit it and run sync again"
    fi

    local missing=() id verdict action inst name
    while IFS='|' read -r id verdict action inst name; do
        [ "$action" = "neutron" ] || continue
        overlay_present "$id" || missing+=("$id")
    done < <(classify)

    # before the early exit, not after: the overlay can be perfectly intact while
    # the per-library shim is gone (a library that was unplugged at install time,
    # or a steam that has since added one), and sync is the only thing that ever
    # runs again on its own
    install_runtime >/dev/null

    if [ "${#missing[@]}" -eq 0 ]; then
        [ "$quiet" = 1 ] || echo "everything is already enabled."
        exit 0
    fi

    local n=0
    for id in "${missing[@]}"; do
        PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" enable "$APPINFO" "$id" >/dev/null 2>&1 \
            && n=$((n + 1))
    done
    [ "$quiet" = 1 ] || echo "re-enabled $n game(s)."
    logger -t neutron "sync: re-enabled $n game(s)" 2>/dev/null || true
}


AGENT_PLIST="$HOME_DIR/Library/LaunchAgents/com.neutron.sync.plist"

# opt-in. runs "neutron sync --quiet" every few minutes.
cmd_autosync() {
    case "${1:-on}" in
        on)
            mkdir -p "$(dirname "$AGENT_PLIST")"
            sed -e "s#__NEUTRON_APP__#$NEUTRON_HOME/app#g" -e "s#__HOME__#$HOME_DIR#g" \
                "$SELF_DIR/src/com.neutron.sync.plist" > "$AGENT_PLIST"
            launchctl bootout "gui/$(id -u)/com.neutron.sync" 2>/dev/null || true
            launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null \
                || launchctl load "$AGENT_PLIST" 2>/dev/null || true
            echo "auto-sync on: new and refreshed games stay enabled by themselves."
            echo "  it only edits the local appinfo cache, and only while steam is closed."
            echo "  turn it off any time with: neutron autosync off"
            ;;
        off)
            launchctl bootout "gui/$(id -u)/com.neutron.sync" 2>/dev/null \
                || launchctl unload "$AGENT_PLIST" 2>/dev/null || true
            rm -f "$AGENT_PLIST"
            echo "auto-sync off (removed)."
            ;;
        *) die "usage: neutron autosync [on|off]" ;;
    esac
}


# put neutron in your steam library so the settings are reachable from there.
cmd_menu() {
    case "${1:-on}" in
        on)
            steam_running && die "quit steam first, then run: neutron menu on"
            local app cfg wrote=0
            for app in "$SELF_DIR/dist/Neutron.app" "/Applications/Neutron.app" \
                       "$NEUTRON_HOME/Neutron.app"; do
                [ -d "$app" ] && break
            done
            [ -d "$app" ] || die "Neutron.app not found (build it with ./build-ui.sh)"
            while IFS= read -r cfg; do
                [ -n "$cfg" ] || continue
                python3 "$SELF_DIR/src/shortcuts.py" add "$cfg/shortcuts.vdf" \
                    "Neutron Settings" "\"/usr/bin/open\"" "$(dirname "$app")" \
                    "-a \"$app\"" && wrote=1
            done < <(configdirs)
            [ "$wrote" = 1 ] || die "no steam user config dir found"
            echo "added \"Neutron Settings\" to your steam library."
            echo "restart steam; it sits with your games and opens the settings window."
            ;;
        off)
            steam_running && die "quit steam first"
            local cfg
            while IFS= read -r cfg; do
                [ -n "$cfg" ] || continue
                python3 "$SELF_DIR/src/shortcuts.py" remove "$cfg/shortcuts.vdf" "Neutron Settings" || true
            done < <(configdirs)
            echo "removed it from your library."
            ;;
        *) die "usage: neutron menu [on|off]" ;;
    esac
}


FORCED="$NEUTRON_HOME/forced"

# games that have a mac build you do not want (cs2's is the legacy CS:GO).
# kept in a list so apply re-does them after every steam update.
cmd_force() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron force <appid>   (or: neutron unforce <appid>)"
    mkdir -p "$NEUTRON_HOME"
    touch "$FORCED"
    grep -qx "$appid" "$FORCED" || echo "$appid" >> "$FORCED"
    echo "$(game_name "$appid") will use its windows build."
    echo "run 'neutron apply' (steam closed) to make it so."
}

cmd_unforce() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron unforce <appid>"
    [ -f "$FORCED" ] && grep -vx "$appid" "$FORCED" > "$FORCED.tmp" && mv "$FORCED.tmp" "$FORCED"
    echo "removed $appid from the forced list (its own mac build will be used again)."
}

# does everything. steam must be closed.
# remove steam_appid.txt files an older neutron wrote into game folders. only
# ours: the file must contain exactly the appid of the game it sits in, which is
# what we used to write. a game that ships its own keeps it.
clean_appid_files() {
    local id dir n=0 f
    classify | while IFS='|' read -r id verdict action inst name; do
        [ -n "$inst" ] && [ -d "$inst" ] || continue
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            if [ "$(tr -dc 0-9 < "$f")" = "$id" ]; then
                rm -f "$f" && echo "  removed a stale steam_appid.txt from $(basename "$inst")"
            fi
        done < <(find "$inst" -maxdepth 4 -name steam_appid.txt 2>/dev/null)
    done
}

cmd_apply() {
    steam_running && die "quit steam first, then run: neutron apply"
    echo "applying neutron..."
    cmd_install >/dev/null || die "setup failed"
    clean_appid_files
    note "runtime + watcher up to date"
    cmd_enable_all | sed -n '$p'
    if [ -f "$FORCED" ]; then
        local id n=0
        while IFS= read -r id; do
            [ -n "$id" ] || continue
            PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" \
                enable "$APPINFO" "$id" --force >/dev/null 2>&1 && n=$((n + 1))
        done < "$FORCED"
        [ "$n" -gt 0 ] && note "forced $n game(s) onto their windows build"
    fi
    cmd_menu on >/dev/null 2>&1 && note "Neutron Settings is in your steam library"
    echo
    echo "done. start steam."
}

cmd_scan() {
    echo "installed games (macOS preferred, neutron handles windows-only):"
    classify | while IFS='|' read -r id verdict action inst name; do
        case "$action" in
            macos)   printf "  native mac   %-9s %s\n" "$id" "$name" ;;
            neutron) printf "  neutron      %-9s %s\n" "$id" "$name" ;;
            review)  printf "  review       %-9s %s (stale mac build?)\n" "$id" "$name" ;;
            *)       printf "  unknown      %-9s %s\n" "$id" "$name" ;;
        esac
    done
}

# --- windows download via a temporary, contained platform override ----------

# stop every installed game auto-updating so the windows override cant drag them
# onto their windows depots; remember what each was so we can put it back
freeze_updates() {
    local f id cur
    mkdir -p "$NEUTRON_HOME/update-freeze"
    for f in "$STEAM/steamapps"/appmanifest_*.acf; do
        [ -f "$f" ] || continue
        id="$(basename "$f" | tr -dc 0-9)"
        cur="$(sed -n 's/.*"AutoUpdateBehavior"[[:space:]]*"\([0-9]\)".*/\1/p' "$f" | head -1)"
        [ -n "$cur" ] || cur=0
        echo "$cur" > "$NEUTRON_HOME/update-freeze/$id"
        grep -q '"AutoUpdateBehavior"' "$f" && \
            sed -i '' 's/\("AutoUpdateBehavior"[[:space:]]*"\)[0-9]"/\11"/' "$f"
    done
    note "paused auto-updates for installed games"
}

thaw_updates() {
    local c id f
    [ -d "$NEUTRON_HOME/update-freeze" ] || return 0
    for c in "$NEUTRON_HOME/update-freeze"/*; do
        [ -f "$c" ] || continue
        id="$(basename "$c")"; f="$STEAM/steamapps/appmanifest_$id.acf"
        [ -f "$f" ] && sed -i '' "s/\(\"AutoUpdateBehavior\"[[:space:]]*\"\)[0-9]\"/\1$(cat "$c")\"/" "$f"
    done
    rm -rf "$NEUTRON_HOME/update-freeze"
    note "restored auto-update settings"
}

override_on() {
    [ -f "$STEAM_DEV_CFG" ] && cp "$STEAM_DEV_CFG" "$NEUTRON_HOME/steam_dev.cfg.bak"
    printf '@sSteamCmdForcePlatformType windows\n' >> "$STEAM_DEV_CFG"
    touch "$NEUTRON_HOME/.override-active"
}

override_off() {
    if [ -f "$NEUTRON_HOME/steam_dev.cfg.bak" ]; then
        cp "$NEUTRON_HOME/steam_dev.cfg.bak" "$STEAM_DEV_CFG"; rm -f "$NEUTRON_HOME/steam_dev.cfg.bak"
    else
        rm -f "$STEAM_DEV_CFG"
    fi
    rm -f "$NEUTRON_HOME/.override-active"
}

override_active() { [ -f "$NEUTRON_HOME/.override-active" ]; }

# StateFlags is a bitfield; bit 4 is "fully installed". dont test == 4, an app
# with a queued update reads 6 and we would wait for ever
game_installed() {
    local f="$STEAM/steamapps/appmanifest_$1.acf" sf
    [ -f "$f" ] || return 1
    sf="$(sed -n 's/.*"StateFlags"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -1)"
    [ -n "$sf" ] || return 1
    [ $((sf & 4)) -ne 0 ]
}

manifest_field() {
    sed -n "s/.*\"$2\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$STEAM/steamapps/appmanifest_$1.acf" 2>/dev/null | head -1
}

quit_steam() {
    steam_running || return 0
    osascript -e 'tell application "Steam" to quit' >/dev/null 2>&1 || pkill -x steam_osx || true
    local i
    for i in $(seq 1 40); do steam_running || return 0; sleep 1; done
    pkill -x steam_osx 2>/dev/null || true
    sleep 2
}

start_steam() { open -a Steam >/dev/null 2>&1 || true; }

# poll the appmanifest until steam reports the app fully installed
wait_for_download() {
    local appid="$1" cap="${2:-10800}" waited=0 done_b total_b sf last=""
    while [ "$waited" -lt "$cap" ]; do
        if game_installed "$appid"; then echo; return 0; fi
        sf="$(manifest_field "$appid" StateFlags)"
        if [ -n "$sf" ]; then
            done_b="$(manifest_field "$appid" BytesDownloaded)"
            total_b="$(manifest_field "$appid" BytesToDownload)"
            if [ -n "$total_b" ] && [ "$total_b" -gt 0 ] 2>/dev/null; then
                last="  downloading: $((done_b / 1048576)) / $((total_b / 1048576)) MB"
            else
                last="  steam state $sf"
            fi
            printf "\r%-60s" "$last"
        fi
        sleep 5
        waited=$((waited + 5))
    done
    echo
    return 1
}

# the one command: mac build -> steam installs it natively; no mac build ->
# steam downloads the windows version, then neutron wires it to a Play button.
cmd_get() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron get <appid>"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    local verdict name
    verdict="$(game_verdict "$appid")"
    name="$(game_name "$appid")"

    if [ "$verdict" = "native-ok" ]; then
        open "steam://install/$appid" 2>/dev/null || true
        echo "$name has a macOS build. Steam is installing the native version, nothing else to do."
        return
    fi

    if game_installed "$appid"; then
        quit_steam
        backup_steam
        wire_game "$appid"
        start_steam
        echo "already installed. launch \"$name\" from your library."
        return
    fi

    echo "$name has no macOS build, pulling its windows depots."
    echo "this uses steam's own download_depot, so we never have to tell steam"
    echo "it is a windows machine and your mac games are untouched."
    echo

    local rows depot manifest size dname staging games target baseline
    rows="$(PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/depots.py" "$appid")" \
        || die "no windows depots found for $appid"

    games="$NEUTRON_HOME/games"
    target="$games/$name"
    mkdir -p "$games"
    rm -rf "$target"

    while read -r depot manifest size dname; do
        [ -n "$depot" ] || continue
        echo "  depot $depot ($((size / 1048576)) MB) ${dname:+- $dname}"
        quit_steam
        # remember how long the log is now, so we only read what this run writes
        baseline="$(wc -l < "$STEAM/logs/console_log.txt" 2>/dev/null || echo 0)"
        open -a Steam --args -console +download_depot "$appid" "$depot" "$manifest" >/dev/null 2>&1
        wait_for_depot "$appid" "$depot" "$baseline" || die "depot $depot did not finish"
        staging="$(depot_staging_dir "$appid" "$depot")"
        [ -d "$staging" ] || die "depot $depot downloaded but I cant find it"
        mkdir -p "$target"
        # depots stack on top of each other to form the install
        (cd "$staging" && tar cf - .) | (cd "$target" && tar xf -)
        rm -rf "$staging"
    done <<< "$rows"

    # deliberately NOT writing steam_appid.txt into the game folder: an extra
    # file in a game's bin dir fails its integrity check. the appid is passed
    # to neutron-run in the environment instead.
    note "installed to $target"

    local exe; exe="$(find_game_exe "$target")"
    mkdir -p "$NEUTRON_HOME/games/.map"; echo "$exe" > "$NEUTRON_HOME/games/.map/$appid"
    quit_steam
    backup_steam
    wire_exe "$name" "$exe" "$appid"
    start_steam
    echo
    echo "done. launch \"$name\" from your steam library."
}

# install through the already-running steam client, no restart. a shortcut's
# Play button calls this the first time, then launches the game.
cmd_get_live() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron get-live <appid>"
    steam_running || die "steam must be running for get-live"

    local rows depot manifest size dname staging target name baseline exe
    name="$(game_name "$appid")"
    rows="$(PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/depots.py" "$appid")" \
        || die "no windows depots for $appid"
    target="$NEUTRON_HOME/games/$name"
    mkdir -p "$NEUTRON_HOME/games"; rm -rf "$target"

    while read -r depot manifest size dname; do
        [ -n "$depot" ] || continue
        baseline="$(wc -l < "$STEAM/logs/console_log.txt" 2>/dev/null || echo 0)"
        python3 "$SELF_DIR/src/steamjs.py" evalfile "$SELF_DIR/src/js/download.js" \
            "$appid" "$depot" "$manifest" >/dev/null 2>&1 || die "could not reach steam (is CEF debugging on?)"
        wait_for_depot "$appid" "$depot" "$baseline" || die "depot $depot did not finish"
        staging="$(depot_staging_dir "$appid" "$depot")"
        [ -d "$staging" ] || die "depot $depot downloaded but not found"
        mkdir -p "$target"
        (cd "$staging" && tar cf - .) | (cd "$target" && tar xf -)
        rm -rf "$staging"
    done <<< "$rows"

    # deliberately NOT writing steam_appid.txt into the game folder: an extra
    # file in a game's bin dir fails its integrity check. the appid is passed
    # to neutron-run in the environment instead.
    exe="$(find_game_exe "$target")"
    mkdir -p "$NEUTRON_HOME/games/.map"; echo "$exe" > "$NEUTRON_HOME/games/.map/$appid"
    # deliberately NOT writing steam_appid.txt into the game folder: an extra
    # file in a game's bin dir fails its integrity check. the appid is passed
    # to neutron-run in the environment instead.
}

# safety net: if a download run was interrupted hard, put steam back
cmd_restore() {
    override_active && note "cleared windows override"
    override_off
    thaw_updates
    echo "steam is back to macOS mode. restart steam if it is running."
}

cmd_remove() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron remove <appid>"
    steam_running && die "close steam first"
    unwire_game "$appid"
    echo "removed appid $appid"
}

# --- updates ------------------------------------------------------------------
# only the scripts update themselves. the engine is 685 MB and changes rarely, so
# when a release needs a newer one we say so and stop rather than pull it down
# behind your back.

REPO_URL="https://api.github.com/repos/mont127/Neutron/releases/latest"

# github allows 60 unauthenticated calls an hour, and this runs on every launch,
# so the answer is cached for an hour. system curl, not python: framework pythons
# have no CA bundle and fail TLS. the User-Agent is required by the api.
latest_tag() {
    local cache="$NEUTRON_HOME/.release-cache" age tag
    if [ -f "$cache" ]; then
        age=$(( $(date +%s) - $(stat -f %m "$cache" 2>/dev/null || echo 0) ))
        if [ "$age" -lt 3600 ]; then cat "$cache"; return 0; fi
    fi
    tag="$(/usr/bin/curl -fsSL --max-time 15 -H "User-Agent: Neutron" "$REPO_URL" 2>/dev/null \
           | sed -n 's/.*"tag_name"[^"]*"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)"
    # only cache a real answer, so being offline does not pin an empty result
    [ -n "$tag" ] && { mkdir -p "$NEUTRON_HOME"; printf '%s' "$tag" > "$cache"; }
    printf '%s' "$tag"
}

installed_version() { cat "$NEUTRON_HOME/version" 2>/dev/null || echo 0; }
installed_engine()  { cat "$NEUTRON_HOME/engine" 2>/dev/null || echo 0; }

newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]; }

cmd_autoupdate() {
    case "${1:-}" in
        on)  echo 1 > "$NEUTRON_HOME/autoupdate"; note "auto-update on" ;;
        off) echo 0 > "$NEUTRON_HOME/autoupdate"; note "auto-update off" ;;
        *)   [ "$(cat "$NEUTRON_HOME/autoupdate" 2>/dev/null || echo 1)" = 1 ] \
                 && echo "auto-update is on" || echo "auto-update is off" ;;
    esac
}

cmd_update() {
    local check=0 tag cur tmp
    [ "${1:-}" = "--check" ] && check=1
    cur="$(installed_version)"

    tag="$(latest_tag)"
    [ -n "$tag" ] || { [ "$check" = 1 ] && return 1; die "could not reach github"; }

    if ! newer "$cur" "$tag"; then
        [ "$check" = 1 ] && return 1
        echo "up to date (v$cur)"; return 0
    fi
    if [ "$check" = 1 ]; then echo "$tag"; return 0; fi

    echo "updating $cur -> $tag"
    tmp="$(mktemp -d)"
    if ! curl -fsSL --max-time 120 "https://codeload.github.com/mont127/Neutron/tar.gz/refs/tags/v$tag" \
         | tar xz -C "$tmp" --strip-components=1 2>/dev/null; then
        rm -rf "$tmp"; die "download failed"
    fi

    # refuse anything that is not a working checkout, so a truncated or wrong
    # tarball cannot replace a runtime that currently works
    if [ ! -f "$tmp/neutron" ] || [ ! -f "$tmp/neutron-run" ] || [ ! -d "$tmp/src" ] \
       || ! bash -n "$tmp/neutron" 2>/dev/null || ! bash -n "$tmp/neutron-run" 2>/dev/null; then
        rm -rf "$tmp"; die "downloaded tree looks wrong, keeping the current one"
    fi

    # a tree with no ENGINE marker predates the check and says nothing about
    # engine compatibility; only an explicit, different marker blocks the update
    new_engine="$(cat "$tmp/ENGINE" 2>/dev/null || true)"
    if [ -n "$new_engine" ] && [ "$new_engine" != "$(installed_engine)" ]; then
        rm -rf "$tmp"
        echo "  v$tag needs a newer engine than you have."
        echo "  download the .dmg from github.com/mont127/Neutron/releases and re-install."
        return 1
    fi

    rm -rf "$NEUTRON_HOME/app.prev"
    [ -d "$NEUTRON_HOME/app" ] && cp -R "$NEUTRON_HOME/app" "$NEUTRON_HOME/app.prev"
    mkdir -p "$NEUTRON_HOME/app"
    cp -R "$tmp/src" "$NEUTRON_HOME/app/"
    cp "$tmp/neutron" "$tmp/neutron-run" "$NEUTRON_HOME/app/"
    [ -d "$tmp/vendor" ] && cp -R "$tmp/vendor" "$NEUTRON_HOME/app/"
    cp "$tmp/neutron-run" "$BIN/neutron-run" 2>/dev/null || true
    chmod +x "$NEUTRON_HOME/app/neutron" "$NEUTRON_HOME/app/neutron-run" "$BIN/neutron-run" 2>/dev/null || true
    for s in neutron-play neutron-watch neutron-launch compat-entry; do
        [ -f "$NEUTRON_HOME/app/src/$s" ] && chmod +x "$NEUTRON_HOME/app/src/$s"
    done
    echo "$tag" > "$NEUTRON_HOME/version"
    rm -rf "$tmp"
    note "updated to v$tag (previous kept in app.prev)"
    note "run 'neutron apply' with steam closed if games need re-enabling"
}

cmd_rollback() {
    [ -d "$NEUTRON_HOME/app.prev" ] || die "no previous version to roll back to"
    rm -rf "$NEUTRON_HOME/app"
    mv "$NEUTRON_HOME/app.prev" "$NEUTRON_HOME/app"
    cp "$NEUTRON_HOME/app/neutron-run" "$BIN/neutron-run" 2>/dev/null || true
    note "rolled back"
}

cmd_status() {
    echo "neutron status"
    [ -f "$CONFIG" ] && { echo "installed:"; sed 's/^/  /' "$CONFIG"; } || echo "  not installed"
    [ -x "$BIN/neutron-run" ] && note "runner: $BIN/neutron-run"
    [ -f "$BIN/steam.exe" ] && note "stub:   $BIN/steam.exe"
    [ -d "$COMPAT_DIR" ] && note "steam play tool: $COMPAT_DIR" || note "steam play tool: not installed"
    if [ -f "$REGISTRY" ]; then
        note "compat mapping:"
        PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" list "$REGISTRY" 2>/dev/null | sed 's/^/    /' || true
    fi
    local cfg
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        note "shortcuts in $(basename "$(dirname "$cfg")"):"
        python3 "$SELF_DIR/src/shortcuts.py" list "$cfg/shortcuts.vdf" 2>/dev/null | sed 's/^/    /' || true
    done < <(configdirs)
}

cmd_uninstall() {
    local purge=0
    [ "${1:-}" = "--purge" ] && purge=1
    steam_running && die "close steam first, then re-run uninstall"
    # if a 'get' was interrupted, put the platform + auto-updates back
    launchctl bootout "gui/$(id -u)/com.neutron.sync" 2>/dev/null || true
    rm -f "$HOME_DIR/Library/LaunchAgents/com.neutron.sync.plist"
    override_active && { override_off; note "cleared leftover windows override"; }
    thaw_updates
    unmap_compat_tool 0
    rm -rf "$COMPAT_DIR"
    note "removed steam play tool"
    if [ -d "$NEUTRON_HOME/steam-backup" ]; then
        local f rel dst
        for f in "$NEUTRON_HOME/steam-backup"/*; do
            [ -f "$f" ] || continue
            rel="$(basename "$f" | sed 's/_/\//g')"
            dst="$STEAM/$rel"
            [ -f "$dst" ] && cp "$f" "$dst" && note "restored $rel"
        done
    fi
    local cfg
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" clean "$cfg/shortcuts.vdf" 2>/dev/null || true
    done < <(configdirs)
    note "removed neutron shortcuts"

    # put each game's appinfo entry back. without this a windows-only game still
    # advertises a macOS build after uninstalling, so steam keeps showing Play
    # and running it lands on a shim that is no longer there
    if [ -f "$APPINFO" ] && [ -f "$NEUTRON_HOME/backup/appinfo.orig.vdf" ]; then
        local id verdict action inst name reverted=0
        while IFS='|' read -r id verdict action inst name; do
            [ "$action" = "neutron" ] || continue
            overlay_present "$id" || continue
            if PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/appoverlay.py" revert \
                 "$APPINFO" "$id" "$NEUTRON_HOME/backup/appinfo.orig.vdf" >/dev/null 2>&1; then
                reverted=$((reverted + 1))
            fi
        done < <(classify)
        note "reverted $reverted game(s) in steam's app cache"
    fi

    local lib
    { echo "$STEAM"; sed -n 's/.*"path"[[:space:]]*"\(.*\)".*/\1/p' \
        "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null; } | sort -u | while IFS= read -r lib; do
        [ -n "$lib" ] || continue
        rm -rf "$lib/steamapps/common/Neutron Runtime" 2>/dev/null || true
    done || true
    note "removed the launch shims"

    local wine
    wine="$(. "$CONFIG" 2>/dev/null; echo "${NEUTRON_WINE:-}")"
    if [ -n "$wine" ]; then
        case "$wine" in
            "$NEUTRON_HOME"/*) rm -rf "$wine"; note "removed deployed wine" ;;
            *) rm -rf "$wine/dlls/lsteamclient"; note "unstaged bridge from $wine" ;;
        esac
    fi
    # the config is the only record of where the engine went, so an install that
    # never finished writing it would otherwise strand several gigabytes
    if [ -d "$NEUTRON_HOME/wine-unified" ]; then
        rm -rf "$NEUTRON_HOME/wine-unified"
        note "removed the engine"
    fi
    rm -rf "$BIN" "$CONFIG" "$NEUTRON_HOME/steam-backup" "$NEUTRON_HOME/backup" \
           "$NEUTRON_HOME/run" "$NEUTRON_HOME/vulkan" "$NEUTRON_HOME/version" \
           "$NEUTRON_HOME/defaults" "$NEUTRON_HOME/.no-d3dmetal"
    [ "$purge" = 1 ] && rm -rf "$NEUTRON_HOME/prefix"
    echo "uninstalled${purge:+ (prefix purged)}"
}

case "${1:-}" in
    install)          shift; cmd_install "$@" ;;
    enable)           shift; cmd_enable "$@" ;;
    disable)          shift; cmd_disable "$@" ;;
    get)              shift; cmd_get "$@" ;;
    enable-game)      shift; cmd_enable_game "$@" ;;
    enable-all)       shift; cmd_enable_all "$@" ;;
    sync)             shift; cmd_sync "$@" ;;
    autosync)         shift; cmd_autosync "$@" ;;
    menu)             shift; cmd_menu "$@" ;;
    apply)            shift; cmd_apply "$@" ;;
    force)            shift; cmd_force "$@" ;;
    unforce)          shift; cmd_unforce "$@" ;;
    set)              shift; cmd_set "$@" ;;
    adopt)            shift; cmd_adopt "$@" ;;
    unadopt)          shift; cmd_unadopt "$@" ;;
    get-live)         shift; cmd_get_live "$@" ;;
    wire-all)         shift; cmd_wire_all "$@" ;;
    restore)          shift; cmd_restore "$@" ;;
    add)              shift; cmd_add "$@" ;;
    add-exe)          shift; cmd_add_exe "$@" ;;
    remove)           shift; cmd_remove "$@" ;;
    scan)             shift; cmd_scan "$@" ;;
    scan-machine)     shift; classify "$@" ;;
    d3dmetal)         shift; cmd_d3dmetal "$@" ;;
    update)           shift; cmd_update "$@" ;;
    autoupdate)       shift; cmd_autoupdate "$@" ;;
    rollback)         shift; cmd_rollback "$@" ;;
    status)           shift; cmd_status "$@" ;;
    uninstall)        shift; cmd_uninstall "$@" ;;
    *) echo "usage: neutron {install|enable|disable|scan|scan-machine|get <appid>|enable-game <appid>|enable-all|sync|autosync on|off|apply|force <appid>|unforce <appid>|menu on|off|set <appid> k=v|adopt <appid>|unadopt <appid>|add <appid>|add-exe <name> <exe> [appid]|remove <appid>|restore|d3dmetal <dmg>|status|update [--check]|autoupdate on|off|rollback|uninstall [--purge]}" >&2; exit 2 ;;
esac
