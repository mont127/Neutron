#!/bin/bash
# neutron - install a proton-like windows-game path into the native mac steam
# client, running through mnc's unified wine. it does not touch the mnc app.
#
#   neutron install [--all]    set up the runtime, back up steam, optionally
#                              wire every installed windows-only game
#   neutron add <appid>        route one game's play button through neutron
#   neutron remove <appid>     undo that
#   neutron status             show what is set up
#   neutron uninstall [--purge]  restore steam, remove neutron (--purge: prefix too)
set -euo pipefail

HOME_DIR="$HOME"
NEUTRON_HOME="$HOME_DIR/Library/Application Support/Neutron"
BIN="$NEUTRON_HOME/bin"
CONFIG="$NEUTRON_HOME/config"
PREFIX_DEFAULT="$NEUTRON_HOME/prefix"
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

STEAM="$HOME_DIR/Library/Application Support/Steam"
STEAM_DEV_CFG="$STEAM/steam_dev.cfg"
COMPAT_DIR="$STEAM/compatibilitytools.d/neutron"
REGISTRY="$STEAM/registry.vdf"
TOOL_NAME="neutron"
DEPLOYED_WINE="$NEUTRON_HOME/wine-unified"
DEPS_WINE="$HOME_DIR/Library/Application Support/MacNCheese/deps/wine-unified"
# only for local dev against a wine build tree; the shipped app never uses it
DEV_WINE="${NEUTRON_DEV_WINE:-}"

die() { echo "neutron: $*" >&2; exit 1; }
note() { echo "  $*"; }

deploy_wine() {
    local src="$1" dst="$2"
    echo "  deploying bundled wine -> $dst" >&2
    mkdir -p "$dst"
    rsync -a --delete "$src/" "$dst/"
}

# the .app sets NEUTRON_BUNDLED_WINE to the private wine inside it; we copy it
# out so it survives the app being thrown away. dev machines fall back to the
# deps or build tree.
resolve_wine() {
    if [ -n "${NEUTRON_BUNDLED_WINE:-}" ] && [ -x "$NEUTRON_BUNDLED_WINE/loader/wine" ]; then
        deploy_wine "$NEUTRON_BUNDLED_WINE" "$DEPLOYED_WINE"
        echo "$DEPLOYED_WINE"; return
    fi
    for d in "$DEPLOYED_WINE" "$DEPS_WINE" "$DEV_WINE"; do
        [ -x "$d/loader/wine" ] && { echo "$d"; return; }
    done
    return 1
}

# the bridge ships inside the unified wine; only fall back to the build tree
bridge_src() {
    local wine="$1" b
    for b in "$wine/dlls/lsteamclient" "$DEV_WINE/dlls/lsteamclient"; do
        [ -f "$b/lsteamclient.so" ] && { echo "$b"; return; }
    done
    return 1
}

steam_running() { pgrep -x steam_osx >/dev/null 2>&1; }

# --- build the stub steam.exe -------------------------------------------------

# the shipped .app carries a prebuilt stub so it needs no compiler; a dev
# checkout builds it from source if mingw is around
provide_stub() {
    mkdir -p "$BIN"
    if [ -f "$SELF_DIR/prebuilt/steam.exe" ]; then
        cp "$SELF_DIR/prebuilt/steam.exe" "$BIN/steam.exe"
        [ -f "$SELF_DIR/prebuilt/steam32.exe" ] && cp "$SELF_DIR/prebuilt/steam32.exe" "$BIN/steam32.exe"
        note "installed prebuilt steam stub"
    elif command -v x86_64-w64-mingw32-gcc >/dev/null; then
        x86_64-w64-mingw32-gcc -static -O2 -o "$BIN/steam.exe" "$SELF_DIR/src/steam_stub.c" -ladvapi32
        command -v i686-w64-mingw32-gcc >/dev/null && \
            i686-w64-mingw32-gcc -static -O2 -o "$BIN/steam32.exe" "$SELF_DIR/src/steam_stub.c" -ladvapi32
        note "built steam stub"
    else
        die "no prebuilt stub and no mingw to build one"
    fi
}

# --- stage the bridge into wine + prefix -------------------------------------

stage_bridge() {
    local wine="$1" prefix="$2" src dst="$wine/dlls/lsteamclient"
    src="$(bridge_src "$wine")" || die "no lsteamclient in the wine (was it built with the bridge?)"

    # the bundled wine already carries the bridge; only copy it in when it came
    # from somewhere else (a dev build tree)
    if [ "$src" != "$dst" ]; then
        mkdir -p "$dst/x86_64-windows" "$dst/i386-windows"
        cp "$src/lsteamclient.so" "$dst/"
        cp "$src/x86_64-windows/lsteamclient.dll" "$dst/x86_64-windows/"
        [ -f "$src/i386-windows/lsteamclient.dll" ] && cp "$src/i386-windows/lsteamclient.dll" "$dst/i386-windows/"
    fi

    # into the prefix so LoadLibrary and the registry path find the pe
    cp "$src/x86_64-windows/lsteamclient.dll" "$prefix/drive_c/windows/system32/lsteamclient.dll"
    [ -f "$src/i386-windows/lsteamclient.dll" ] && \
        cp "$src/i386-windows/lsteamclient.dll" "$prefix/drive_c/windows/syswow64/lsteamclient.dll"
    note "staged bridge into prefix"
}

# --- steam play compatibility tool -------------------------------------------
# this is how proton does it: register a compat tool, then map it in the
# registry. steam then offers Install for windows-only titles and launches them
# through us, no platform override and no shortcuts needed.

install_compat_tool() {
    mkdir -p "$COMPAT_DIR"
    cp "$SELF_DIR/src/compat-entry" "$COMPAT_DIR/compat-entry"
    chmod +x "$COMPAT_DIR/compat-entry"

    cat > "$COMPAT_DIR/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
	"compat_tools"
	{
		"$TOOL_NAME"
		{
			"install_path"	"."
			"display_name"	"Neutron"
			"from_oslist"	"windows"
			"to_oslist"	"macos"
		}
	}
}
EOF

    cat > "$COMPAT_DIR/toolmanifest.vdf" <<'EOF'
"manifest"
{
	"version"	"2"
	"commandline"	"/compat-entry %verb%"
	"compatmanager_layer_name"	"neutron"
}
EOF
    note "registered steam play tool in $COMPAT_DIR"
}

# appid 0 is the global default: every windows-only title becomes installable
map_compat_tool() {
    local appid="${1:-0}"
    [ -f "$REGISTRY" ] || die "no registry.vdf, has steam ever run?"
    cp "$REGISTRY" "$NEUTRON_HOME/registry.vdf.bak" 2>/dev/null || true
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" set "$REGISTRY" "$appid" "$TOOL_NAME" \
        || die "could not write CompatToolMapping"
    [ "$appid" = 0 ] && note "steam play enabled for all windows titles" \
                     || note "steam play enabled for appid $appid"
}

unmap_compat_tool() {
    local appid="${1:-0}"
    [ -f "$REGISTRY" ] && PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" clear "$REGISTRY" "$appid" || true
}

# --- steam launch options ----------------------------------------------------

configdirs() {
    find "$STEAM/userdata" -maxdepth 2 -type d -name config 2>/dev/null
}

# give a windows-only game a Play button via a non-steam shortcut that runs it
# through neutron-run. resolves the exe, drops steam_appid.txt so the game
# reports to the right appid, and writes the shortcut for every steam user.
wire_game() {
    local appid="$1" info base exe name cfg vdf wrote=0
    info="$(PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/gameexe.py" "$STEAM" "$appid")" || \
        die "appid $appid is not installed (download its windows depots first: neutron download $appid --confirm)"
    base="${info%%|*}"; name="${info##*|}"; exe="${info#*|}"; exe="${exe%|*}"
    [ -n "$exe" ] && [ -f "$exe" ] || die "could not find the windows exe for $appid under $base"
    echo "$appid" > "$(dirname "$exe")/steam_appid.txt"
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        vdf="$cfg/shortcuts.vdf"
        python3 "$SELF_DIR/src/shortcuts.py" add "$vdf" "$name (Neutron)" \
            "\"$BIN/neutron-run\"" "$base" "\"$exe\"" && wrote=1
    done < <(configdirs)
    [ "$wrote" = 1 ] || die "no steam user config dir found"
    note "shortcut: $name (Neutron) -> $exe"
}

unwire_game() {
    local appid="$1" info name cfg
    info="$(PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/gameexe.py" "$STEAM" "$appid" 2>/dev/null)" || return 0
    name="${info##*|}"
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" remove "$cfg/shortcuts.vdf" "$name (Neutron)" || true
    done < <(configdirs)
}

backup_steam() {
    local cfg f rel
    mkdir -p "$NEUTRON_HOME/steam-backup"
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        for f in "$cfg/localconfig.vdf" "$cfg/shortcuts.vdf"; do
            [ -f "$f" ] || continue
            rel="$(echo "$f" | sed "s#$STEAM/##; s#/#_#g")"
            [ -f "$NEUTRON_HOME/steam-backup/$rel" ] || cp "$f" "$NEUTRON_HOME/steam-backup/$rel"
        done
    done < <(configdirs)
    note "backed up steam config"
}

# --- classification: prefer macos, neutron only for windows-only -------------

classify() {
    PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/classify.py" "$STEAM" "$@"
}

game_verdict() { classify "$1" | head -1 | cut -d'|' -f2; }

installed_windows_games() {
    classify | awk -F'|' '$2 == "windows-only" { print $1 }'
}

# --- subcommands -------------------------------------------------------------

cmd_install() {
    local wine prefix all=0
    [ "${1:-}" = "--all" ] && all=1
    wine="$(resolve_wine)" || die "no unified wine found (no bundle, deps or build tree)"
    prefix="$PREFIX_DEFAULT"
    echo "installing neutron (wine: $wine)"

    mkdir -p "$BIN"
    provide_stub
    cp "$SELF_DIR/neutron-run" "$BIN/neutron-run"
    chmod +x "$BIN/neutron-run"

    if [ ! -d "$prefix/drive_c" ]; then
        note "creating prefix $prefix"
        WINEPREFIX="$prefix" WINEARCH=win64 WINEDEBUG=-all \
            arch -x86_64 /bin/bash -lc 'export DYLD_FALLBACK_LIBRARY_PATH="${MNC_DYLD:-/usr/local/lib}"; exec "$0" wineboot --init' "$wine/wine" >/dev/null 2>&1 || true
    fi

    stage_bridge "$wine" "$prefix"

    # seed the registry once so steam_api can find the client dll before a run
    WINEPREFIX="$prefix" WINEDEBUG=-all \
        arch -x86_64 /bin/bash -lc 'export DYLD_FALLBACK_LIBRARY_PATH="${MNC_DYLD:-/usr/local/lib}"; exec "$0" "$1" --once' "$wine/wine" "$BIN/steam.exe" >/dev/null 2>&1 || true

    cat > "$CONFIG" <<EOF
NEUTRON_WINE="$wine"
NEUTRON_PREFIX="$prefix"
MNC_GAME_BACKEND="d3dmetal"
MNC_DYLD="/usr/local/lib"
EOF
    note "wrote $CONFIG"

    backup_steam
    install_compat_tool
    if steam_running; then
        echo
        echo "installed, but steam is running so the compat tool isnt enabled yet."
        echo "quit steam and run:  neutron enable"
    else
        map_compat_tool 0
        echo
        echo "done. start steam: windows-only games now have an Install button and"
        echo "launch through neutron."
    fi
}

cmd_add() {
    local appid="" force=0 a
    for a in "$@"; do
        case "$a" in --force) force=1 ;; *) appid="$a" ;; esac
    done
    [ -n "$appid" ] || die "usage: neutron add <appid> [--force]"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    local verdict; verdict="$(game_verdict "$appid")"
    if [ "$verdict" = "native-ok" ] && [ "$force" != 1 ]; then
        die "appid $appid has a macOS build, Steam runs it natively. use --force to route it through neutron anyway."
    fi
    steam_running && die "close steam first (it rewrites its config on exit)"
    backup_steam
    wire_game "$appid"
    echo "added. restart steam and launch \"$(game_name "$appid") (Neutron)\" from your library."
}

game_name() { classify "$1" | head -1 | cut -d'|' -f4; }

cmd_enable() {
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "quit steam first, then run: neutron enable"
    [ -d "$COMPAT_DIR" ] || install_compat_tool
    map_compat_tool "${1:-0}"
    echo "start steam. windows-only games now show Install and run through neutron."
}

cmd_disable() {
    steam_running && die "quit steam first, then run: neutron disable"
    unmap_compat_tool "${1:-0}"
    echo "steam play mapping removed. restart steam."
}

# wire any windows exe (not necessarily in the steam library) to a Play button
cmd_add_exe() {
    local name="${1:-}" exe="${2:-}" appid="${3:-}" base cfg wrote=0
    [ -n "$name" ] && [ -n "$exe" ] || die "usage: neutron add-exe <name> <exe.path> [appid]"
    [ -f "$exe" ] || die "no such exe: $exe"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    steam_running && die "close steam first (it rewrites its config on exit)"
    base="$(dirname "$exe")"
    [ -n "$appid" ] && echo "$appid" > "$base/steam_appid.txt"
    backup_steam
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" add "$cfg/shortcuts.vdf" "$name (Neutron)" \
            "\"$BIN/neutron-run\"" "$base" "\"$exe\"" && wrote=1
    done < <(configdirs)
    [ "$wrote" = 1 ] || die "no steam user config dir found"
    echo "added \"$name (Neutron)\". restart steam and launch it from your library."
}

cmd_scan() {
    echo "installed games (macOS preferred, neutron handles windows-only):"
    classify | while IFS='|' read -r id verdict action name; do
        case "$action" in
            macos)   printf "  native mac   %-9s %s\n" "$id" "$name" ;;
            neutron) printf "  neutron      %-9s %s\n" "$id" "$name" ;;
            review)  printf "  review       %-9s %s (stale mac build?)\n" "$id" "$name" ;;
            *)       printf "  unknown      %-9s %s\n" "$id" "$name" ;;
        esac
    done
}

# --- windows download via a temporary, contained platform override ----------

# stop every installed game auto-updating so the windows override cant drag them
# onto their windows depots; remember what each was so we can put it back
freeze_updates() {
    local f id cur
    mkdir -p "$NEUTRON_HOME/update-freeze"
    for f in "$STEAM/steamapps"/appmanifest_*.acf; do
        [ -f "$f" ] || continue
        id="$(basename "$f" | tr -dc 0-9)"
        cur="$(sed -n 's/.*"AutoUpdateBehavior"[[:space:]]*"\([0-9]\)".*/\1/p' "$f" | head -1)"
        [ -n "$cur" ] || cur=0
        echo "$cur" > "$NEUTRON_HOME/update-freeze/$id"
        grep -q '"AutoUpdateBehavior"' "$f" && \
            sed -i '' 's/\("AutoUpdateBehavior"[[:space:]]*"\)[0-9]"/\11"/' "$f"
    done
    note "paused auto-updates for installed games"
}

thaw_updates() {
    local c id f
    [ -d "$NEUTRON_HOME/update-freeze" ] || return 0
    for c in "$NEUTRON_HOME/update-freeze"/*; do
        [ -f "$c" ] || continue
        id="$(basename "$c")"; f="$STEAM/steamapps/appmanifest_$id.acf"
        [ -f "$f" ] && sed -i '' "s/\(\"AutoUpdateBehavior\"[[:space:]]*\"\)[0-9]\"/\1$(cat "$c")\"/" "$f"
    done
    rm -rf "$NEUTRON_HOME/update-freeze"
    note "restored auto-update settings"
}

override_on() {
    [ -f "$STEAM_DEV_CFG" ] && cp "$STEAM_DEV_CFG" "$NEUTRON_HOME/steam_dev.cfg.bak"
    printf '@sSteamCmdForcePlatformType windows\n' >> "$STEAM_DEV_CFG"
    touch "$NEUTRON_HOME/.override-active"
}

override_off() {
    if [ -f "$NEUTRON_HOME/steam_dev.cfg.bak" ]; then
        cp "$NEUTRON_HOME/steam_dev.cfg.bak" "$STEAM_DEV_CFG"; rm -f "$NEUTRON_HOME/steam_dev.cfg.bak"
    else
        rm -f "$STEAM_DEV_CFG"
    fi
    rm -f "$NEUTRON_HOME/.override-active"
}

override_active() { [ -f "$NEUTRON_HOME/.override-active" ]; }

# StateFlags is a bitfield; bit 4 is "fully installed". dont test == 4, an app
# with a queued update reads 6 and we would wait for ever
game_installed() {
    local f="$STEAM/steamapps/appmanifest_$1.acf" sf
    [ -f "$f" ] || return 1
    sf="$(sed -n 's/.*"StateFlags"[[:space:]]*"\([0-9]*\)".*/\1/p' "$f" | head -1)"
    [ -n "$sf" ] || return 1
    [ $((sf & 4)) -ne 0 ]
}

manifest_field() {
    sed -n "s/.*\"$2\"[[:space:]]*\"\([0-9]*\)\".*/\1/p" "$STEAM/steamapps/appmanifest_$1.acf" 2>/dev/null | head -1
}

quit_steam() {
    steam_running || return 0
    osascript -e 'tell application "Steam" to quit' >/dev/null 2>&1 || pkill -x steam_osx || true
    local i
    for i in $(seq 1 40); do steam_running || return 0; sleep 1; done
    pkill -x steam_osx 2>/dev/null || true
    sleep 2
}

start_steam() { open -a Steam >/dev/null 2>&1 || true; }

# poll the appmanifest until steam reports the app fully installed
wait_for_download() {
    local appid="$1" cap="${2:-10800}" waited=0 done_b total_b sf last=""
    while [ "$waited" -lt "$cap" ]; do
        if game_installed "$appid"; then echo; return 0; fi
        sf="$(manifest_field "$appid" StateFlags)"
        if [ -n "$sf" ]; then
            done_b="$(manifest_field "$appid" BytesDownloaded)"
            total_b="$(manifest_field "$appid" BytesToDownload)"
            if [ -n "$total_b" ] && [ "$total_b" -gt 0 ] 2>/dev/null; then
                last="  downloading: $((done_b / 1048576)) / $((total_b / 1048576)) MB"
            else
                last="  steam state $sf"
            fi
            printf "\r%-60s" "$last"
        fi
        sleep 5
        waited=$((waited + 5))
    done
    echo
    return 1
}

# the one command: mac build -> steam installs it natively; no mac build ->
# steam downloads the windows version, then neutron wires it to a Play button.
cmd_get() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron get <appid>"
    [ -f "$CONFIG" ] || die "run 'neutron install' first"
    local verdict name
    verdict="$(game_verdict "$appid")"
    name="$(game_name "$appid")"

    if [ "$verdict" = "native-ok" ]; then
        open "steam://install/$appid" 2>/dev/null || true
        echo "$name has a macOS build. Steam is installing the native version, nothing else to do."
        return
    fi

    if game_installed "$appid"; then
        quit_steam
        backup_steam
        wire_game "$appid"
        start_steam
        echo "already installed. launch \"$name (Neutron)\" from your library."
        return
    fi

    echo "$name has no macOS build."
    echo
    echo "steam only accepts the windows platform switch at runtime, from its own"
    echo "console. it resets by itself when steam restarts, so it cant leak."
    echo

    # make sure the console tab is available
    if ! steam_running; then
        start_steam
        sleep 8
    fi
    open "steam://open/console" >/dev/null 2>&1 || true

    cat <<EOM
in steam, open the CONSOLE tab and paste this line:

    @sSteamCmdForcePlatformType windows

then install $name normally. leave the rest to me.

EOM
    echo "waiting for the download (ctrl-c is safe)..."
    if ! wait_for_download "$appid"; then
        echo "gave up waiting. when it finishes run: neutron get $appid"
        exit 1
    fi
    echo "download complete."

    quit_steam
    backup_steam
    wire_game "$appid"
    start_steam
    echo
    echo "done. launch \"$name (Neutron)\" from your steam library."
}

# safety net: if a download run was interrupted hard, put steam back
cmd_restore() {
    override_active && note "cleared windows override"
    override_off
    thaw_updates
    echo "steam is back to macOS mode. restart steam if it is running."
}

cmd_remove() {
    local appid="${1:-}"
    [ -n "$appid" ] || die "usage: neutron remove <appid>"
    steam_running && die "close steam first"
    unwire_game "$appid"
    echo "removed appid $appid"
}

cmd_status() {
    echo "neutron status"
    [ -f "$CONFIG" ] && { echo "installed:"; sed 's/^/  /' "$CONFIG"; } || echo "  not installed"
    [ -x "$BIN/neutron-run" ] && note "runner: $BIN/neutron-run"
    [ -f "$BIN/steam.exe" ] && note "stub:   $BIN/steam.exe"
    [ -d "$COMPAT_DIR" ] && note "steam play tool: $COMPAT_DIR" || note "steam play tool: not installed"
    if [ -f "$REGISTRY" ]; then
        note "compat mapping:"
        PYTHONPATH="$SELF_DIR/src" python3 "$SELF_DIR/src/compatmap.py" list "$REGISTRY" 2>/dev/null | sed 's/^/    /' || true
    fi
    local cfg
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        note "shortcuts in $(basename "$(dirname "$cfg")"):"
        python3 "$SELF_DIR/src/shortcuts.py" list "$cfg/shortcuts.vdf" 2>/dev/null | sed 's/^/    /' || true
    done < <(configdirs)
}

cmd_uninstall() {
    local purge=0
    [ "${1:-}" = "--purge" ] && purge=1
    steam_running && die "close steam first, then re-run uninstall"
    # if a 'get' was interrupted, put the platform + auto-updates back
    override_active && { override_off; note "cleared leftover windows override"; }
    thaw_updates
    unmap_compat_tool 0
    rm -rf "$COMPAT_DIR"
    note "removed steam play tool"
    if [ -d "$NEUTRON_HOME/steam-backup" ]; then
        local f rel dst
        for f in "$NEUTRON_HOME/steam-backup"/*; do
            [ -f "$f" ] || continue
            rel="$(basename "$f" | sed 's/_/\//g')"
            dst="$STEAM/$rel"
            [ -f "$dst" ] && cp "$f" "$dst" && note "restored $rel"
        done
    fi
    local cfg
    while IFS= read -r cfg; do
        [ -n "$cfg" ] || continue
        python3 "$SELF_DIR/src/shortcuts.py" clean "$cfg/shortcuts.vdf" 2>/dev/null || true
    done < <(configdirs)
    note "removed neutron shortcuts"
    local wine
    wine="$(. "$CONFIG" 2>/dev/null; echo "${NEUTRON_WINE:-}")"
    if [ -n "$wine" ]; then
        case "$wine" in
            "$NEUTRON_HOME"/*) rm -rf "$wine"; note "removed deployed wine" ;;
            *) rm -rf "$wine/dlls/lsteamclient"; note "unstaged bridge from $wine" ;;
        esac
    fi
    rm -rf "$BIN" "$CONFIG"
    [ "$purge" = 1 ] && rm -rf "$NEUTRON_HOME/prefix"
    rm -rf "$NEUTRON_HOME/steam-backup"
    echo "uninstalled${purge:+ (prefix purged)}"
}

case "${1:-}" in
    install)          shift; cmd_install "$@" ;;
    enable)           shift; cmd_enable "$@" ;;
    disable)          shift; cmd_disable "$@" ;;
    get)              shift; cmd_get "$@" ;;
    restore)          shift; cmd_restore "$@" ;;
    add)              shift; cmd_add "$@" ;;
    add-exe)          shift; cmd_add_exe "$@" ;;
    remove)           shift; cmd_remove "$@" ;;
    scan)             shift; cmd_scan "$@" ;;
    status)           shift; cmd_status "$@" ;;
    uninstall)        shift; cmd_uninstall "$@" ;;
    *) echo "usage: neutron {install|enable|disable|scan|get <appid>|add <appid>|add-exe <name> <exe> [appid]|remove <appid>|restore|status|uninstall [--purge]}" >&2; exit 2 ;;
esac
