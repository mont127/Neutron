<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neutron.sync</string>
    <!-- runs "neutron sync --quiet": if steam is closed and a windows game has
         lost its overlay (new purchase, or steam refreshed the app's metadata),
         put it back. does nothing otherwise. no network, no ports, no injection. -->
    <key>ProgramArguments</key>
    <array>
        <string>__NEUTRON_APP__/neutron</string>
        <string>sync</string>
        <string>--quiet</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/neutron-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/neutron-sync.log</string>
</dict>
</plist>
