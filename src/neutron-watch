#!/bin/bash
# steam rewrites its app metadata and drops our overlay. this puts it back.
#
# checks every 3s but only stats a file: real work happens when appinfo actually
# changed and steam is closed, since steam would overwrite us otherwise.
set -uo pipefail

N="$HOME/Library/Application Support/Neutron"
APPINFO="$HOME/Library/Application Support/Steam/appcache/appinfo.vdf"
INTERVAL="${NEUTRON_WATCH_INTERVAL:-3}"
last=""
pending=0

while :; do
    sleep "$INTERVAL"
    [ -f "$APPINFO" ] || continue

    now="$(stat -f %m "$APPINFO" 2>/dev/null)"
    [ -n "$now" ] || continue
    if [ "$now" != "$last" ]; then
        last="$now"
        pending=1          # steam touched it; re-check as soon as steam is gone
    fi
    [ "$pending" = 1 ] || continue

    # never edit while steam is up - it holds appinfo in memory and writes on exit
    pgrep -x steam_osx >/dev/null 2>&1 && continue

    if [ -x "$N/app/neutron" ]; then
        "$N/app/neutron" sync --quiet >/dev/null 2>&1
        pending=0
    fi
done &

# check the release on every launch, then hourly. the lookup itself is cached for
# an hour inside neutron, so this is one github call an hour at most. a release
# that carries a new engine marker fetches and restages that too. turn it off
# with:
#   neutron autoupdate off
notify() {
    /usr/bin/osascript -e "display notification \"$1\" with title \"Neutron\"" \
        >/dev/null 2>&1 || true
}

while :; do
    if [ -x "$N/app/neutron" ]; then
        new="$("$N/app/neutron" update --check 2>/dev/null || true)"
        if [ -n "$new" ]; then
            if [ "$(cat "$N/autoupdate" 2>/dev/null || echo 1)" = 1 ]; then
                # never swap the scripts under a running steam session
                if ! pgrep -x steam_osx >/dev/null 2>&1; then
                    # kept rather than discarded: an unattended update is the
                    # one that restages the prefix, and when it cannot stage
                    # something this file is the only place that says so
                    if "$N/app/neutron" update >"$N/update.log" 2>&1; then
                        notify "Updated to v$new"
                    fi
                fi
            elif [ "$(cat "$N/.notified" 2>/dev/null)" != "$new" ]; then
                printf '%s' "$new" > "$N/.notified"
                notify "v$new is available. Open Neutron to update."
            fi
        fi
    fi
    sleep 3600
done
